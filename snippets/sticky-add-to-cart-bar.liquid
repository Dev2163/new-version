{% comment %}
  ONE9 Luxury Streetwear - Sticky Add to Cart Bar (Exact Reference Match)
{% endcomment %}

<div id="one9-sticky-cart-bar" class="one9-sticky-cart" aria-hidden="true">
  <div class="one9-sticky-cart__card">
    
    <!-- Product Thumbnail in Rounded White Box -->
    <div class="one9-sticky-cart__thumb-box">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy" id="sticky-cart-img">
      {% endif %}
    </div>

    <!-- Product Info (Title, Variant Subtitle, Price & Compare Price) -->
    <div class="one9-sticky-cart__info">
      <div class="one9-sticky-cart__title">{{ product.title }}</div>
      <div class="one9-sticky-cart__variant-title" id="sticky-cart-selected-variant">
        {{ product.selected_or_first_available_variant.title }}
      </div>
      <div class="one9-sticky-cart__price-row">
        <span class="one9-sticky-cart__price" id="sticky-cart-price">{{ product.selected_or_first_available_variant.price | money }}</span>
        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
          <span class="one9-sticky-cart__compare-price" id="sticky-cart-compare-price">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
        {% endif %}
      </div>
    </div>

    <!-- Actions (Variant Dropdown + Quantity Stepper + Add to Cart Button with Cart Icon) -->
    <div class="one9-sticky-cart__actions">
      {% if product.has_only_default_variant == false %}
        <div class="one9-sticky-cart__select-wrapper">
          <select id="sticky-variant-selector" class="one9-sticky-select" aria-label="Select Variant" onchange="ONE9_UpdateStickyVariant(this)">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" data-price="{{ variant.price | money }}" data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}" data-title="{{ variant.title }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }} {% unless variant.available %}(Sold Out){% endunless %}
              </option>
            {% endfor %}
          </select>
          <span class="select-arrow">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </div>
      {% endif %}

      <!-- Quantity Stepper -->
      <div class="one9-sticky-qty-stepper">
        <button type="button" class="qty-btn" onclick="ONE9_ChangeStickyQty(-1)">−</button>
        <span id="sticky-qty-val" class="qty-val">1</span>
        <button type="button" class="qty-btn" onclick="ONE9_ChangeStickyQty(1)">+</button>
      </div>

      <!-- Add to Cart Button -->
      <button type="button" id="sticky-add-to-cart-btn" class="one9-sticky-btn" onclick="ONE9_StickyAddToCart()">
        <svg class="cart-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="btn-text">Add to cart</span>
      </button>
    </div>

  </div>
</div>

<style>
  .one9-sticky-cart {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%) translateY(140%);
    width: calc(100% - 32px);
    max-width: 860px;
    z-index: 999998;
    opacity: 0;
    visibility: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease, visibility 0.35s ease;
    box-sizing: border-box;
  }

  .one9-sticky-cart.is-visible {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    visibility: visible;
  }

  /* Main Card Layout - Black, Gold & White Luxury Theme */
  .one9-sticky-cart__card {
    background: #0E0E12;
    border: 1px solid rgba(244, 196, 48, 0.45);
    border-radius: 18px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.95), 0 0 25px rgba(244, 196, 48, 0.15);
  }

  @media (max-width: 768px) {
    .one9-sticky-cart {
      bottom: 75px;
      width: calc(100% - 20px);
    }
    .one9-sticky-cart__card {
      padding: 8px 10px;
      gap: 10px;
      border-radius: 16px;
    }
    .one9-sticky-cart__variant-title {
      display: none;
    }
  }

  /* Rounded White Image Box with Gold Border Glow */
  .one9-sticky-cart__thumb-box {
    width: 48px;
    height: 48px;
    background: #FFFFFF;
    border: 1px solid rgba(244, 196, 48, 0.4);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 3px;
    box-sizing: border-box;
  }

  .one9-sticky-cart__thumb-box img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Info */
  .one9-sticky-cart__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .one9-sticky-cart__title {
    font-family: 'Orbitron', 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: #FFFFFF;
    letter-spacing: 0.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
  }

  .one9-sticky-cart__variant-title {
    font-size: 11px;
    color: #AAAAAA;
  }

  .one9-sticky-cart__price-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .one9-sticky-cart__price {
    font-family: 'Orbitron', sans-serif;
    font-weight: 900;
    font-size: 15px;
    color: #F4C430;
  }

  .one9-sticky-cart__compare-price {
    font-size: 12px;
    color: #777777;
    text-decoration: line-through;
  }

  /* Actions */
  .one9-sticky-cart__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  /* Select Box (Gold Accents) */
  .one9-sticky-cart__select-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .one9-sticky-select {
    appearance: none;
    -webkit-appearance: none;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(244, 196, 48, 0.4);
    border-radius: 10px;
    color: #FFFFFF;
    font-family: 'Orbitron', sans-serif;
    font-size: 12px;
    font-weight: 700;
    padding: 10px 32px 10px 14px;
    outline: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .one9-sticky-select:hover,
  .one9-sticky-select:focus {
    border-color: #F4C430;
    box-shadow: 0 0 12px rgba(244, 196, 48, 0.25);
    background: rgba(255, 255, 255, 0.1);
  }

  .one9-sticky-select option {
    background: #0E0E12;
    color: #FFF;
    font-family: sans-serif;
  }

  .select-arrow {
    position: absolute;
    right: 10px;
    pointer-events: none;
    color: #F4C430;
    display: flex;
    align-items: center;
  }

  /* Quantity Stepper: - 1 + */
  .one9-sticky-qty-stepper {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(244, 196, 48, 0.4);
    border-radius: 10px;
    padding: 4px 8px;
    gap: 12px;
  }

  .qty-btn {
    background: transparent;
    border: none;
    color: #F4C430;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    padding: 4px;
    line-height: 1;
    transition: color 0.2s;
  }

  .qty-btn:hover {
    color: #FFD700;
  }

  .qty-val {
    font-family: 'Orbitron', sans-serif;
    font-size: 13px;
    font-weight: 800;
    color: #FFF;
    min-width: 14px;
    text-align: center;
  }

  /* Add to cart Button (Gold Luxury Gradient) */
  .one9-sticky-btn {
    background: linear-gradient(135deg, #F4C430 0%, #E5A900 100%);
    color: #000000;
    border: none;
    border-radius: 10px;
    font-family: 'Orbitron', sans-serif;
    font-size: 12px;
    font-weight: 900;
    padding: 10px 22px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: all 0.25s ease;
    box-shadow: 0 4px 20px rgba(244, 196, 48, 0.4);
  }

  .one9-sticky-btn:hover {
    background: linear-gradient(135deg, #FFD700 0%, #F4C430 100%);
    transform: translateY(-1px);
    box-shadow: 0 6px 28px rgba(244, 196, 48, 0.65);
  }

  .cart-icon {
    flex-shrink: 0;
  }
</style>

<script>
(function() {
  let currentQty = 1;

  function initStickyBar() {
    const stickyBar = document.getElementById('one9-sticky-cart-bar');
    const mainBuyBtn = document.querySelector('.cp-add-to-cart-btn, [name="add"], #product-form-custom button[type="submit"]');

    if (!stickyBar || !mainBuyBtn) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) {
          stickyBar.classList.add('is-visible');
          stickyBar.setAttribute('aria-hidden', 'false');
        } else {
          stickyBar.classList.remove('is-visible');
          stickyBar.setAttribute('aria-hidden', 'true');
        }
      });
    }, { rootMargin: '0px 0px -50px 0px', threshold: 0 });

    observer.observe(mainBuyBtn);
  }

  window.ONE9_UpdateStickyVariant = function(selectEl) {
    const opt = selectEl.options[selectEl.selectedIndex];
    if (!opt) return;

    const price = opt.getAttribute('data-price');
    const comparePrice = opt.getAttribute('data-compare-price');
    const title = opt.getAttribute('data-title');

    const priceEl = document.getElementById('sticky-cart-price');
    const compareEl = document.getElementById('sticky-cart-compare-price');
    const titleEl = document.getElementById('sticky-cart-selected-variant');

    if (priceEl && price) priceEl.textContent = price;
    if (titleEl && title) titleEl.textContent = title;

    if (compareEl) {
      if (comparePrice) {
        compareEl.textContent = comparePrice;
        compareEl.style.display = 'inline';
      } else {
        compareEl.style.display = 'none';
      }
    }
  };

  window.ONE9_ChangeStickyQty = function(delta) {
    currentQty = Math.max(1, currentQty + delta);
    const qtyEl = document.getElementById('sticky-qty-val');
    if (qtyEl) qtyEl.textContent = currentQty;
  };

  window.ONE9_StickyAddToCart = function() {
    const select = document.getElementById('sticky-variant-selector');
    const variantId = select ? select.value : '{{ product.selected_or_first_available_variant.id }}';
    const btn = document.getElementById('sticky-add-to-cart-btn');

    if (!variantId) return;

    btn.style.opacity = '0.75';
    btn.querySelector('.btn-text').textContent = 'Adding...';

    const cartItemsComp = document.querySelector('cart-items-component');
    const sectionId = cartItemsComp ? cartItemsComp.dataset.sectionId : null;

    const formData = new FormData();
    formData.append('id', variantId);
    formData.append('quantity', currentQty);
    if (sectionId) {
      formData.append('sections', sectionId);
      formData.append('sections_url', window.location.pathname);
    }

    fetch('/cart/add', {
      method: 'POST',
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'text/html'
      },
      body: formData
    })
    .then(res => {
      if (!res.ok) throw new Error('Cart add failed: ' + res.status);
      return res.json();
    })
    .then(data => {
      btn.style.opacity = '1';
      btn.querySelector('.btn-text').textContent = 'Added! ✓';
      
      // Refresh cart drawer content using rendered section HTML from the response
      if (data.sections && sectionId && data.sections[sectionId]) {
        const freshHtml = data.sections[sectionId];
        const parser = new DOMParser();
        const doc = parser.parseFromString(freshHtml, 'text/html');
        const freshComp = doc.querySelector('cart-items-component');
        if (freshComp && cartItemsComp) {
          cartItemsComp.innerHTML = freshComp.innerHTML;
          // Also remove empty class from dialog
          const dialog = document.querySelector('.cart-drawer__dialog');
          if (dialog) dialog.classList.remove('cart-drawer--empty');
        }
      }

      // Update cart count badges
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          document.querySelectorAll('.cart-bubble__text, .mobile-bottom-nav__badge').forEach(el => {
            el.textContent = cart.item_count;
          });
        })
        .catch(() => {});

      // Open Cart Drawer
      setTimeout(() => {
        const cartDrawer = document.querySelector('cart-drawer-component');
        if (cartDrawer && typeof cartDrawer.open === 'function') {
          cartDrawer.open();
        } else if (cartDrawer && typeof cartDrawer.showDialog === 'function') {
          cartDrawer.showDialog();
        }
      }, 300);

      setTimeout(() => {
        if (btn && btn.querySelector('.btn-text')) {
          btn.querySelector('.btn-text').textContent = 'Add to cart';
        }
      }, 2000);
    })
    .catch((err) => {
      console.error('Sticky Cart add error:', err);
      window.location.href = `/cart/add?id=${variantId}&quantity=${currentQty}`;
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStickyBar);
  } else {
    initStickyBar();
  }
})();
</script>
