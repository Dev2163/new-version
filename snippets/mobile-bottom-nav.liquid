{% comment %}
  ONE9 Luxury Streetwear - Mobile App Bottom Navigation Bar
  Top Header on Mobile: Shows ONLY Logo & Search Icon
  Bottom Navbar: Contains 5 Clean Icons (Home, Menu, Wishlist, Cart, Account)
{% endcomment %}

<nav class="mobile-bottom-nav" aria-label="Mobile Navigation">
  <!-- 1. Home -->
  <a href="/" class="mobile-bottom-nav__item {% if template == 'index' %}active{% endif %}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </svg>
    <span class="nav-label">Home</span>
  </a>

  <!-- 2. Menu (Opens Navigation Drawer) -->
  <button type="button" class="mobile-bottom-nav__item" onclick="openMobileMenu()">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
    <span class="nav-label">Menu</span>
  </button>

  <!-- 3. Wishlist -->
  <a href="/pages/wishlist" class="mobile-bottom-nav__item {% if template contains 'wishlist' %}active{% endif %}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
    <span class="wishlist-count-badge mobile-bottom-nav__badge" style="display: none;">0</span>
    <span class="nav-label">Wishlist</span>
  </a>

  <!-- 4. Cart -->
  <a href="/cart" class="mobile-bottom-nav__item {% if template contains 'cart' %}active{% endif %}" onclick="openMobileCart(event)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <path d="M16 10a4 4 0 0 1-8 0"></path>
    </svg>
    {%- if cart.item_count > 0 -%}
      <span class="mobile-bottom-nav__badge">{{ cart.item_count }}</span>
    {%- endif -%}
    <span class="nav-label">Cart</span>
  </a>

  <!-- 5. Account -->
  <a href="{% if customer %}/account{% else %}/account/login{% endif %}" class="mobile-bottom-nav__item {% if template contains 'account' or template contains 'login' %}active{% endif %}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </svg>
    <span class="nav-label">Account</span>
  </a>
</nav>

<style>
  @media screen and (max-width: 768px) {
    /* Completely remove extra icons & secondary header rows on mobile */
    .header__drawer,
    .header__column .header__drawer,
    header-component .header__drawer,
    details.menu-drawer-container > summary,
    summary.header__icon--menu,
    .header__icon--menu,
    header-actions .account-button,
    header-actions [aria-label="View Wishlist"],
    header-actions cart-drawer-component,
    header-actions .action__cart,
    header-actions .header-actions__cart-icon,
    .header__row--bottom,
    .header__row:nth-child(2),
    .menu-list--mobile {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      width: 0 !important;
      height: 0 !important;
      min-height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      border: none !important;
      pointer-events: none !important;
    }

    /* Ensure dark background color for header and eliminate white space gap */
    #header-component,
    header-component,
    .header,
    .header__row--top,
    .header__row {
      background-color: #0A0A0A !important;
    }

    /* Force top header row container to relative positioning and clean fixed height */
    #header-component .header__row--top,
    header-component .header__row--top,
    .header__row--top,
    .header__row:first-of-type {
      position: relative !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      height: 56px !important;
      min-height: 56px !important;
      max-height: 56px !important;
      margin: 0 !important;
      padding: 0 16px !important;
    }

    /* Force ONE9 Logo to be DEAD-CENTER in the middle of the mobile screen */
    #header-component .header-logo,
    #header-component header-logo,
    #header-component .header__logo,
    .header-logo {
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      margin: 0 !important;
      padding: 0 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      z-index: 10 !important;
    }

    /* Force Search icon button to be VISIBLE on mobile header (override theme drawer-hide rule) */
    search-button,
    .search-action,
    .search-action--hidden-on-drawer,
    .search-action--hidden-on-menu,
    [data-menu-style='drawer'] .search-action--hidden-on-drawer,
    [data-menu-style='drawer'] .search-action {
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
      color: #FFFFFF !important;
      z-index: 99 !important;
    }

    search-button button,
    .search-action button,
    .search-action svg,
    search-button svg {
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
      color: #FFFFFF !important;
      fill: currentColor !important;
    }

    /* Force Search icon to be anchored on the far right edge of the mobile header */
    #header-component search-component,
    #header-component .search-action,
    #header-component search-button,
    #header-component .header__search,
    header-component .header__search,
    .header__column--right {
      position: absolute !important;
      right: 16px !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      margin: 0 !important;
      z-index: 11 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: flex-end !important;
    }

    /* Mobile Bottom Navigation Bar Styling */
    .mobile-bottom-nav {
      position: fixed !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      height: 62px !important;
      height: calc(62px + env(safe-area-inset-bottom, 0px)) !important;
      padding-bottom: env(safe-area-inset-bottom, 0px) !important;
      background: rgba(10, 10, 14, 0.96) !important;
      backdrop-filter: blur(20px) !important;
      -webkit-backdrop-filter: blur(20px) !important;
      border-top: 1px solid rgba(244, 196, 48, 0.3) !important;
      box-shadow: 0 -8px 25px rgba(0, 0, 0, 0.8), 0 0 15px rgba(244, 196, 48, 0.15) !important;
      z-index: 999990 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: space-around !important;
    }

    body {
      padding-bottom: calc(64px + env(safe-area-inset-bottom, 0px)) !important;
    }
  }

  @media screen and (min-width: 769px) {
    .mobile-bottom-nav {
      display: none !important;
    }
  }

  .mobile-bottom-nav__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    height: 100%;
    color: #888888;
    text-decoration: none;
    background: transparent;
    border: none;
    outline: none;
    padding: 6px 0;
    position: relative;
    cursor: pointer;
    font-family: 'Rajdhani', sans-serif;
    transition: all 0.25s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-bottom-nav__item svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    transition: transform 0.25s ease, stroke 0.25s ease;
  }

  .mobile-bottom-nav__item span.nav-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-top: 4px;
    transition: color 0.25s ease;
  }

  .mobile-bottom-nav__item.active,
  .mobile-bottom-nav__item:hover {
    color: #F4C430 !important;
  }

  .mobile-bottom-nav__item.active svg {
    transform: translateY(-2px) scale(1.1);
  }

  .mobile-bottom-nav__item.active::after {
    content: '';
    position: absolute;
    top: 0;
    width: 22px;
    height: 2px;
    background: #F4C430;
    border-radius: 0 0 2px 2px;
    box-shadow: 0 0 8px #F4C430;
  }

  .mobile-bottom-nav__badge {
    position: absolute;
    top: 4px;
    right: calc(50% - 16px);
    background: #F4C430;
    color: #000000;
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    font-weight: 900;
    min-width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1px;
    box-shadow: 0 0 8px rgba(244, 196, 48, 0.6);
  }
</style>

<script>
  function openMobileMenu() {
    const detailsElem = document.querySelector('details.menu-drawer-container, details#Details-menu-drawer-container');
    if (detailsElem) {
      detailsElem.setAttribute('open', '');
      detailsElem.classList.add('menu-open');
      document.body.classList.add('overflow-hidden');
    } else {
      window.location.href = '/collections/all';
    }
  }

  function openMobileCart(e) {
    const cartTrigger = document.querySelector('cart-drawer-component button[data-testid="cart-drawer-trigger"], header-actions cart-drawer-component button, .action__cart');
    if (cartTrigger) {
      e.preventDefault();
      cartTrigger.click();
    }
  }
</script>
