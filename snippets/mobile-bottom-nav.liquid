{% comment %}
  ONE9 Luxury Streetwear - Mobile App Bottom Navigation Bar
  Top Header on Mobile: Shows ONLY Logo & Search Icon
  Bottom Navbar: Contains EXACTLY 5 Icons (Home, Shoes, Zodiac, Cart, Menu)
  Menu drawer contains Wishlist, Account, Track Order, Our Story, Contact
{% endcomment %}

<nav class="mobile-bottom-nav" aria-label="Mobile Navigation">
  <!-- 1. Home -->
  <a href="/" class="mobile-bottom-nav__item nav-item-home {% if template == 'index' or request.path == '/' %}active{% endif %}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </svg>
    <span class="nav-label">Home</span>
  </a>

  <!-- 2. Shoes -->
  <a href="/collections/shoes" class="mobile-bottom-nav__item nav-item-shoes {% if request.path contains 'shoes' %}active{% endif %}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2.5 17.5h19v3h-19z"></path>
      <path d="M4 17.5l2-6 5 1.5 6-5 3.5 1.5.5 8"></path>
      <line x1="8" y1="12" x2="10" y2="17.5"></line>
      <line x1="12" y1="11" x2="14" y2="17.5"></line>
    </svg>
    <span class="nav-label">Shoes</span>
  </a>

  <!-- 3. Zodiac -->
  <a href="/collections/find-your-zodiac" class="mobile-bottom-nav__item nav-item-zodiac {% if request.path contains 'zodiac' %}active{% endif %}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5z"></path>
    </svg>
    <span class="nav-label">Zodiac</span>
  </a>

  <!-- 4. Cart -->
  <a href="/cart" class="mobile-bottom-nav__item nav-item-cart {% if template contains 'cart' or request.path contains 'cart' %}active{% endif %}" onclick="openMobileCart(event)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <path d="M16 10a4 4 0 0 1-8 0"></path>
    </svg>
    {%- if cart.item_count > 0 -%}
      <span class="mobile-bottom-nav__badge">{{ cart.item_count }}</span>
    {%- endif -%}
    <span class="nav-label">Cart</span>
  </a>

  <!-- 5. Menu (Opens Drawer containing Wishlist, Account, etc.) -->
  <button type="button" class="mobile-bottom-nav__item nav-item-menu {% if template contains 'page' or template contains 'wishlist' or template contains 'account' or template contains 'login' %}active{% endif %}" onclick="openMobileMenu(event)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
    <span class="nav-label">Menu</span>
  </button>
</nav>

<style>
  @media screen and (max-width: 768px) {
    /* Hide Sales & Recent Purchase Notification Popups on mobile view */
    #one9-purchase-toast,
    .one9-purchase-toast,
    .recent-purchase-popup,
    #recent-purchase-popup,
    .recent-order-pop,
    .sales-popup,
    .sales-pop,
    #sales-pop,
    .verified-buyer-popup,
    [data-testid="recent-purchase-popup"] {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
      z-index: -9999 !important;
    }

    /* Completely hide top header menu drawer summary button on mobile */
    header-drawer summary,
    .header__drawer summary,
    details.menu-drawer-container > summary,
    summary.header__icon--menu {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      width: 0 !important;
      height: 0 !important;
      position: absolute !important;
      top: -9999px !important;
      left: -9999px !important;
      overflow: hidden !important;
      pointer-events: none !important;
    }

    /* Hide ALL trigger buttons and text labels inside header-actions on mobile EXCEPT search-button */
    header-actions cart-drawer-component > button,
    header-actions cart-drawer-component [data-testid="cart-drawer-trigger"],
    .cart-drawer > button,
    .cart-drawer [data-testid="cart-drawer-trigger"],
    .cart-drawer--text > button,
    header-actions .account-button,
    header-actions shopify-account,
    header-actions a[href*="wishlist"],
    header-actions [aria-label="View Wishlist"],
    header-actions .action__cart,
    header-actions .header-actions__cart-icon,
    header-actions .header-actions__text,
    header-actions > a:not(search-button *),
    .header__row--bottom,
    .header__row:nth-child(2),
    .menu-list--mobile {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      width: 0 !important;
      height: 0 !important;
      min-height: 0 !important;
      max-width: 0 !important;
      max-height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      border: none !important;
      pointer-events: none !important;
      position: absolute !important;
      top: -9999px !important;
      left: -9999px !important;
      overflow: hidden !important;
    }

    /* Ensure Cart Drawer Component container takes zero header space while Dialog remains 100% functional */
    cart-drawer-component {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
      width: 0 !important;
      height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      position: absolute !important;
      top: 0 !important;
      right: 0 !important;
    }

    cart-drawer-component dialog,
    dialog.cart-drawer__dialog,
    .cart-drawer__dialog {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      width: auto !important;
      height: auto !important;
      margin: auto !important;
    }

    /* Ensure dark background color for header and eliminate white space gap */
    #header-component,
    header-component,
    .header,
    .header__row--top,
    .header__row {
      background-color: #0A0A0A !important;
    }

    /* Force top header row container to relative positioning and clean fixed height */
    #header-component .header__row--top,
    header-component .header__row--top,
    .header__row--top,
    .header__row:first-of-type {
      position: relative !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      height: 56px !important;
      min-height: 56px !important;
      max-height: 56px !important;
      margin: 0 !important;
      padding: 0 16px !important;
    }

    /* Force ONE9 Logo to be DEAD-CENTER in the middle of the mobile screen */
    #header-component .header-logo,
    #header-component header-logo,
    #header-component .header__logo,
    .header-logo {
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      margin: 0 !important;
      padding: 0 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      z-index: 10 !important;
    }

    /* Right column container holding search icon - anchored vertically in header */
    .header__column--right,
    header-component .header__column--right {
      position: absolute !important;
      right: 16px !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      margin: 0 !important;
      padding: 0 !important;
      height: 44px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: flex-end !important;
      z-index: 11 !important;
    }

    /* Inner search button elements inside right column - unhide and align vertically */
    search-button,
    .search-action,
    .search-action--hidden-on-drawer,
    .search-action--hidden-on-menu,
    [data-menu-style='drawer'] .search-action--hidden-on-drawer,
    [data-menu-style='drawer'] .search-action,
    search-component,
    .header__search {
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
      color: #FFFFFF !important;
      position: relative !important;
      top: auto !important;
      right: auto !important;
      transform: none !important;
      margin: 0 !important;
      padding: 0 !important;
      height: 100% !important;
      align-items: center !important;
      justify-content: center !important;
      z-index: 99 !important;
    }

    search-button button,
    .search-action button,
    .search-action svg,
    search-button svg {
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
      color: #FFFFFF !important;
      margin: 0 !important;
      transform: none !important;
    }

    search-button svg,
    .search-action svg {
      width: 20px !important;
      height: 20px !important;
      fill: none !important;
      stroke: #FFFFFF !important;
      stroke-width: 2px !important;
    }

    search-button svg circle,
    .search-action svg circle {
      fill: none !important;
      stroke: #FFFFFF !important;
      stroke-width: 2px !important;
    }

    search-button svg line,
    .search-action svg line {
      stroke: #FFFFFF !important;
      stroke-width: 2px !important;
    }

    /* Mobile Bottom Navigation Bar Styling */
    .mobile-bottom-nav {
      position: fixed !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      height: 62px !important;
      height: calc(62px + env(safe-area-inset-bottom, 0px)) !important;
      padding-bottom: env(safe-area-inset-bottom, 0px) !important;
      background: rgba(10, 10, 14, 0.96) !important;
      backdrop-filter: blur(20px) !important;
      -webkit-backdrop-filter: blur(20px) !important;
      border-top: 1px solid rgba(244, 196, 48, 0.3) !important;
      box-shadow: 0 -8px 25px rgba(0, 0, 0, 0.8), 0 0 15px rgba(244, 196, 48, 0.15) !important;
      z-index: 999999 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: space-around !important;
      pointer-events: auto !important;
    }

    body {
      padding-bottom: calc(64px + env(safe-area-inset-bottom, 0px)) !important;
    }
  }

  @media screen and (min-width: 769px) {
    .mobile-bottom-nav {
      display: none !important;
    }
  }

  .mobile-bottom-nav__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    height: 100%;
    color: #888888;
    text-decoration: none;
    background: transparent;
    border: none;
    outline: none;
    padding: 6px 0;
    position: relative;
    cursor: pointer;
    font-family: 'Rajdhani', sans-serif;
    transition: all 0.25s ease;
    -webkit-tap-highlight-color: transparent;
    pointer-events: auto !important;
    z-index: 999999 !important;
  }

  .mobile-bottom-nav__item svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    transition: transform 0.25s ease, stroke 0.25s ease, filter 0.25s ease;
  }

  .mobile-bottom-nav__item span.nav-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-top: 4px;
    transition: color 0.25s ease, text-shadow 0.25s ease;
  }

  /* Active & Hover States - Prominent Gold Highlight */
  .mobile-bottom-nav__item.active,
  .mobile-bottom-nav__item:hover {
    color: #F4C430 !important;
  }

  .mobile-bottom-nav__item.active svg {
    color: #F4C430 !important;
    stroke: #F4C430 !important;
    transform: translateY(-2px) scale(1.15) !important;
    filter: drop-shadow(0 0 6px rgba(244, 196, 48, 0.8)) !important;
  }

  .mobile-bottom-nav__item.active span.nav-label {
    color: #F4C430 !important;
    font-weight: 800 !important;
    text-shadow: 0 0 8px rgba(244, 196, 48, 0.6) !important;
  }

  .mobile-bottom-nav__item.active::after {
    content: '';
    position: absolute;
    top: 0;
    width: 28px;
    height: 3px;
    background: #F4C430;
    border-radius: 0 0 4px 4px;
    box-shadow: 0 0 12px #F4C430, 0 0 4px #F4C430;
  }

  .mobile-bottom-nav__badge {
    position: absolute;
    top: 4px;
    right: calc(50% - 16px);
    background: #F4C430;
    color: #000000;
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    font-weight: 900;
    min-width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1px;
    box-shadow: 0 0 8px rgba(244, 196, 48, 0.6);
  }
</style>

<script>
  function openMobileMenu(e) {
    if (e && e.preventDefault) e.preventDefault();
    if (e && e.stopPropagation) e.stopPropagation();

    const details = document.querySelector('details.menu-drawer-container, details#Details-menu-drawer-container, header-drawer details');
    if (details) {
      if (details.hasAttribute('open')) {
        details.removeAttribute('open');
        details.classList.remove('menu-open');
        document.body.classList.remove('overflow-hidden', 'menu-open');
      } else {
        details.setAttribute('open', '');
        details.classList.add('menu-open');
        document.body.classList.add('overflow-hidden', 'menu-open');
      }
    } else {
      window.location.href = '/collections/all';
    }
  }

  function openMobileCart(e) {
    if (e && e.preventDefault) e.preventDefault();
    if (e && e.stopPropagation) e.stopPropagation();

    const dialog = document.querySelector('cart-drawer-component dialog, dialog.cart-drawer__dialog, #cart-drawer-dialog, dialog[data-testid="cart-drawer-dialog"]');
    const trigger = document.querySelector('[data-testid="cart-drawer-trigger"], cart-drawer-component button, .action__cart, cart-icon');

    if (dialog) {
      if (typeof dialog.showModal === 'function') {
        try {
          if (!dialog.open) {
            dialog.showModal();
          }
          document.body.classList.add('overflow-hidden');
          return;
        } catch(err) {
          console.warn('showModal failed:', err);
        }
      }
      dialog.setAttribute('open', '');
      dialog.classList.add('active', 'is-open');
      const comp = document.querySelector('cart-drawer-component');
      if (comp) comp.classList.add('active', 'is-open');
      document.body.classList.add('overflow-hidden');
      return;
    }

    if (trigger) {
      trigger.click();
      return;
    }

    window.location.href = '/cart';
  }

  function insertZodiacAfterShoesInMobileMenu() {
    const menuLists = document.querySelectorAll('.menu-drawer__navigation ul, .menu-drawer__menu');
    menuLists.forEach(function(ul) {
      const items = Array.from(ul.children);
      const zodiacItems = items.filter(function(li) { return li.textContent.toLowerCase().includes('zodiac'); });
      
      if (zodiacItems.length > 1) {
        for (let i = 1; i < zodiacItems.length; i++) {
          zodiacItems[i].remove();
        }
      } else if (zodiacItems.length === 0) {
        const shoesLi = items.find(function(li) { return li.textContent.toLowerCase().includes('shoes'); });
        if (shoesLi) {
          const zodiacLi = document.createElement('li');
          zodiacLi.className = shoesLi.className || 'menu-drawer__list-item--flat';
          zodiacLi.innerHTML = `
            <a href="/collections/find-your-zodiac" class="menu-drawer__menu-item menu-drawer__menu-item--mainlist focus-inset">
              <span class="menu-drawer__menu-item-text wrap-text">Zodiac</span>
            </a>
          `;
          shoesLi.insertAdjacentElement('afterend', zodiacLi);
        }
      }

      ul.querySelectorAll('a[href*="zodiac"] .menu-drawer__menu-item-text').forEach(function(el) {
        el.textContent = 'Zodiac';
      });
    });
  }

  // Auto Active Page Matching & Menu Insertion on Client Load
  document.addEventListener('DOMContentLoaded', function() {
    try {
      insertZodiacAfterShoesInMobileMenu();
      setTimeout(insertZodiacAfterShoesInMobileMenu, 200);
      setTimeout(insertZodiacAfterShoesInMobileMenu, 800);

      const path = window.location.pathname.toLowerCase();
      let matched = false;

      if (path.includes('/collections/find-your-zodiac') || path.includes('zodiac')) {
        document.querySelector('.nav-item-zodiac')?.classList.add('active');
        matched = true;
      } else if (path.includes('/collections/shoes') || path.includes('shoes')) {
        document.querySelector('.nav-item-shoes')?.classList.add('active');
        matched = true;
      } else if (path.includes('/cart')) {
        document.querySelector('.nav-item-cart')?.classList.add('active');
        matched = true;
      } else if (path.includes('wishlist') || path.includes('account') || path.includes('login') || path.includes('pages')) {
        document.querySelector('.nav-item-menu')?.classList.add('active');
        matched = true;
      } else if (path === '/' || path === '' || path.includes('index')) {
        document.querySelector('.nav-item-home')?.classList.add('active');
        matched = true;
      }

      // Fallback: Default to Home if unmapped URL
      if (!matched && !document.querySelector('.mobile-bottom-nav__item.active')) {
        document.querySelector('.nav-item-home')?.classList.add('active');
      }
    } catch(e) {}

    function hideMobileHeaderCartButton() {
      if (window.innerWidth <= 768) {
        try {
          const cartTriggers = document.querySelectorAll('header-actions [data-testid="cart-drawer-trigger"], header-actions cart-drawer-component > button, .cart-drawer--text > button');
          cartTriggers.forEach(function(btn) {
            btn.style.setProperty('display', 'none', 'important');
            btn.style.setProperty('visibility', 'hidden', 'important');
            btn.style.setProperty('width', '0', 'important');
            btn.style.setProperty('height', '0', 'important');
            btn.style.setProperty('opacity', '0', 'important');
            btn.style.setProperty('position', 'absolute', 'important');
            btn.style.setProperty('top', '-9999px', 'important');
          });

          const textSpans = document.querySelectorAll('header-actions .header-actions__text');
          textSpans.forEach(function(span) {
            span.style.setProperty('display', 'none', 'important');
          });
        } catch(err) {}
      }
    }

    hideMobileHeaderCartButton();
    window.addEventListener('resize', hideMobileHeaderCartButton);
    setTimeout(hideMobileHeaderCartButton, 100);
    setTimeout(hideMobileHeaderCartButton, 500);
    setTimeout(hideMobileHeaderCartButton, 1200);

    // JS Enforcer: Permanently hide header-drawer summary (hamburger/X) on mobile
    // CSS alone is not winning the specificity battle — JS ensures it
    function hideMobileHeaderDrawerButton() {
      if (window.innerWidth > 768) return;
      try {
        // 1. Hide the summary (hamburger/X toggle) — bottom nav handles Menu
        var summaries = document.querySelectorAll(
          'header-drawer summary, summary.header__icon--menu, summary.header__icon--summary, details.menu-drawer-container > summary'
        );
        summaries.forEach(function(s) {
          s.style.setProperty('display', 'none', 'important');
          s.style.setProperty('visibility', 'hidden', 'important');
          s.style.setProperty('width', '0', 'important');
          s.style.setProperty('height', '0', 'important');
          s.style.setProperty('position', 'absolute', 'important');
          s.style.setProperty('left', '-9999px', 'important');
          s.style.setProperty('pointer-events', 'none', 'important');
        });

        // 2. Collapse header-actions to 0 space (overflow:visible keeps dialog accessible)
        var headerActions = document.querySelectorAll('header-actions');
        headerActions.forEach(function(el) {
          el.style.setProperty('width', '0', 'important');
          el.style.setProperty('height', '0', 'important');
          el.style.setProperty('overflow', 'visible', 'important');
          el.style.setProperty('position', 'absolute', 'important');
        });

        // 3. Hide specific header-actions children: account, wishlist, cart trigger button
        // DO NOT hide cart-drawer-component — dialog inside it needs to open
        var hideTargets = document.querySelectorAll(
          'header-actions .account-button, header-actions shopify-account, header-actions a[href*="wishlist"], header-actions [aria-label="View Wishlist"], header-actions button[data-testid="cart-drawer-trigger"], header-actions cart-drawer-component > button'
        );
        hideTargets.forEach(function(el) {
          el.style.setProperty('display', 'none', 'important');
          el.style.setProperty('visibility', 'hidden', 'important');
          el.style.setProperty('width', '0', 'important');
          el.style.setProperty('height', '0', 'important');
          el.style.setProperty('pointer-events', 'none', 'important');
        });

        // 4. Hide search in left or center column (drawer_search duplicate)
        var leftSearches = document.querySelectorAll(
          '.header__column--left search-button, .header__column--left .search-action, .header__column--center search-button, .header__column--center .search-action'
        );
        leftSearches.forEach(function(el) {
          el.style.setProperty('display', 'none', 'important');
        });

        // 5. Force show the right column search button
        var rightSearches = document.querySelectorAll(
          '.header__column--right search-button, .header__column--right .search-action'
        );
        rightSearches.forEach(function(el) {
          el.style.setProperty('display', 'flex', 'important');
          el.style.setProperty('visibility', 'visible', 'important');
          el.style.setProperty('opacity', '1', 'important');
          el.style.setProperty('position', 'static', 'important');
          el.style.setProperty('width', 'auto', 'important');
          el.style.setProperty('height', 'auto', 'important');
        });
      } catch(err) {}
    }

    hideMobileHeaderDrawerButton();
    window.addEventListener('resize', hideMobileHeaderDrawerButton);
    setTimeout(hideMobileHeaderDrawerButton, 50);
    setTimeout(hideMobileHeaderDrawerButton, 200);
    setTimeout(hideMobileHeaderDrawerButton, 600);
    setTimeout(hideMobileHeaderDrawerButton, 1500);
  });
</script>
