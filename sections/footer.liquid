<div id="shopify-section-{{ section.id }}-wrapper" class="custom-footer-wrapper" style="background-color: {{ section.settings.bg_color | default: '#0A0A0A' }}; color: {{ section.settings.text_color | default: '#E0E0E0' }};">
  <div class="page-width">
    <div class="custom-footer">
      
      <!-- Column 1: Brand & Newsletter -->
      <div class="footer-col brand-col">
        <h2>
          <a href="/" class="footer-logo">{{ section.settings.brand_logo_text | default: 'ONE9' }}</a>
        </h2>
        <div class="brand-text">
          {{ section.settings.brand_text | default: '<p>Zodiac streetwear inspired by your energy.<br>Built different. Worn everywhere.</p>' }}
        </div>
        
        {%- if section.settings.show_newsletter -%}
          <div class="footer-newsletter">
            <h4 class="newsletter-heading">{{ section.settings.newsletter_heading | default: 'SUBSCRIBE TO THE DROP' }}</h4>
            <div class="newsletter-subtext">{{ section.settings.newsletter_subtext }}</div>
            {%- form 'customer', id: 'FooterNewsletterForm', class: 'footer-newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="newsletter-input-wrapper">
                <input
                  id="NewsletterForm--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="newsletter-input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="ContactFooter-success"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="ContactFooter-success"
                  {% endif %}
                  placeholder="ENTER YOUR EMAIL"
                  required
                >
                <button type="submit" class="newsletter-submit-btn" name="commit" id="Subscribe" aria-label="Subscribe">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </button>
              </div>
              {%- if form.errors -%}
                <small class="newsletter-message error" id="ContactFooter-error">
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </small>
              {%- endif -%}
              {%- if form.posted_successfully? -%}
                <h3 class="newsletter-message success" id="ContactFooter-success" tabindex="-1" autofocus>
                  SUCCESSFULLY SUBSCRIBED!
                </h3>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_socials -%}
          <div class="social-icons">
            {%- if section.settings.instagram_link != blank -%}
              <a href="{{ section.settings.instagram_link }}" target="_blank" aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.tiktok_link != blank -%}
              <a href="{{ section.settings.tiktok_link }}" target="_blank" aria-label="TikTok">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.whatsapp_link != blank -%}
              <a href="{{ section.settings.whatsapp_link }}" target="_blank" aria-label="WhatsApp">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-7.6-4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.twitter_link != blank -%}
              <a href="{{ section.settings.twitter_link }}" target="_blank" aria-label="Twitter">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.youtube_link != blank -%}
              <a href="{{ section.settings.youtube_link }}" target="_blank" aria-label="YouTube">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Column 2: SHOP -->
      <div class="footer-col">
        <h3 class="col-heading">{{ section.settings.shop_heading | default: 'SHOP' }}</h3>
        <ul class="footer-links">
          {%- if section.settings.shop_menu != blank -%}
            {%- for link in section.settings.shop_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/collections/all">Shop All</a></li>
            <li><a href="/collections/men">Men</a></li>
            <li><a href="/collections/women">Women</a></li>
            <li><a href="/collections/new-arrivals">New Arrivals</a></li>
            <li><a href="/pages/contact">Contact</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 3: HELP -->
      <div class="footer-col">
        <h3 class="col-heading">{{ section.settings.help_heading | default: 'HELP' }}</h3>
        <ul class="footer-links">
          {%- if section.settings.help_menu != blank -%}
            {%- for link in section.settings.help_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/contact">Track Your Order</a></li>
            <li><a href="/pages/contact">Shipping & Delivery</a></li>
            <li><a href="/pages/contact">Returns & Exchanges</a></li>
            <li><a href="/pages/contact">FAQs</a></li>
            <li><a href="/pages/contact">Size Guide</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 4: ABOUT -->
      <div class="footer-col">
        <h3 class="col-heading">{{ section.settings.about_heading | default: 'ABOUT' }}</h3>
        <ul class="footer-links">
          {%- if section.settings.about_menu != blank -%}
            {%- for link in section.settings.about_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/about">Our Story</a></li>
            <li><a href="/pages/about">Sustainability</a></li>
            <li><a href="/pages/about">Careers</a></li>
            <li><a href="/pages/about">Press</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 5: CONTACT -->
      <div class="footer-col contact-col">
        <h3 class="col-heading">{{ section.settings.contact_heading | default: 'CONTACT' }}</h3>
        <ul class="contact-list">
          {%- if section.settings.address != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span>{{ section.settings.address }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span>{{ section.settings.phone }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              <span>{{ section.settings.email }}</span>
            </li>
          {%- endif -%}
        </ul>
        {%- if section.settings.btn_text != blank -%}
          <a href="{{ section.settings.btn_link | default: '/pages/contact' }}" class="btn-get-in-touch">{{ section.settings.btn_text | default: 'GET IN TOUCH' }}</a>
        {%- endif -%}
      </div>

    </div>

    <!-- Bottom Copyright & Payment Bar -->
    <div class="footer-bottom">
      <div class="copyright-text">
        {{ section.settings.copyright_text | default: '© 2026 ONE9 Streetwear. All rights reserved.' }}
      </div>
      
      {%- if section.settings.show_payment_icons -%}
        <div class="footer-payment-icons">
          <ul class="payment-list" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="payment-list-item">
                {{ type | payment_type_svg_tag: class: 'icon icon--payment' }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  #shopify-section-{{ section.id }}-wrapper {
    --accent-color: {{ section.settings.accent_color | default: '#F4C430' }};
  }

  .custom-footer-wrapper {
    padding: 80px 0 40px;
    font-family: var(--font-body-family, sans-serif);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
  }

  /* Top Accent glow bar */
  .custom-footer-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-color), transparent);
    opacity: 0.8;
  }

  .custom-footer {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1.4fr;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
    animation: footerFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes footerFadeIn {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 1024px) {
    .custom-footer {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 30px;
    }
    .brand-col {
      grid-column: 1 / -1;
      margin-bottom: 20px;
    }
  }

  @media screen and (max-width: 768px) {
    .custom-footer-wrapper {
      padding: 60px 0 30px;
    }
    .custom-footer {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 0 24px;
    }
    .brand-col, .contact-col {
      grid-column: 1 / -1;
      text-align: left;
    }
    .social-icons {
      justify-content: flex-start;
    }
    .contact-list li {
      justify-content: flex-start;
    }
  }

  .footer-logo {
    font-size: 36px;
    font-weight: 900;
    margin: 0 0 16px 0;
    letter-spacing: 4px;
    color: var(--accent-color);
    font-family: "Orbitron", "Rajdhani", sans-serif;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-block;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    text-shadow: 0 0 15px rgba(244, 196, 48, 0.15);
  }

  .footer-logo:hover {
    letter-spacing: 8px;
    text-shadow: 0 0 20px var(--accent-color);
  }

  .brand-text {
    font-size: 14px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 28px;
  }

  /* Newsletter styles */
  .footer-newsletter {
    margin: 24px 0;
    max-width: 320px;
  }

  .newsletter-heading {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 2px;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .newsletter-subtext {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .newsletter-input-wrapper {
    display: flex;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
    position: relative;
    transition: border-color 0.3s ease;
    padding-bottom: 6px;
  }

  .newsletter-input-wrapper:focus-within {
    border-bottom-color: var(--accent-color);
  }

  .newsletter-input {
    background: transparent;
    border: none;
    color: #ffffff;
    font-family: inherit;
    font-size: 13px;
    width: 100%;
    padding: 8px 32px 8px 0;
    letter-spacing: 0.05em;
  }

  .newsletter-input:focus {
    outline: none;
  }

  .newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .newsletter-submit-btn {
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .newsletter-submit-btn svg {
    width: 18px;
    height: 18px;
  }

  .newsletter-submit-btn:hover {
    color: var(--accent-color);
    transform: translateY(-50%) translateX(4px);
  }

  .newsletter-message {
    display: block;
    margin-top: 10px;
    font-size: 12px;
    font-family: 'Rajdhani', sans-serif;
    letter-spacing: 1px;
  }

  .newsletter-message.error {
    color: #ff4d4d;
  }

  .newsletter-message.success {
    color: var(--accent-color);
  }

  /* Social Icons styling */
  .social-icons {
    display: flex;
    gap: 12px;
    margin-top: 28px;
  }

  .social-icons a {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .social-icons a svg {
    width: 18px;
    height: 18px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .social-icons a:hover {
    background: var(--accent-color);
    border-color: var(--accent-color);
    color: #000000;
    transform: translateY(-4px);
    box-shadow: 0 6px 15px rgba(244, 196, 48, 0.15);
  }

  .social-icons a:hover svg {
    transform: rotate(360deg);
  }

  /* Headings & Link lists */
  .col-heading {
    font-size: 15px;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 24px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-links a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-size: 14px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: inline-block;
    position: relative;
    padding-left: 0;
  }

  .footer-links a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0;
    height: 1.5px;
    background-color: var(--accent-color);
    transform: translateY(-50%);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
  }

  .footer-links a:hover {
    color: var(--accent-color);
    padding-left: 12px;
  }

  .footer-links a:hover::before {
    width: 6px;
    opacity: 1;
  }

  /* Contact List */
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
    line-height: 1.5;
    transition: color 0.3s ease;
  }

  .contact-list li:hover {
    color: #ffffff;
  }

  .contact-list svg {
    width: 16px;
    height: 16px;
    color: var(--accent-color);
    margin-top: 3px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .contact-list li:hover svg {
    transform: scale(1.15);
  }

  /* Get in touch button */
  .btn-get-in-touch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border: 1px solid var(--accent-color);
    color: var(--accent-color);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 2px;
    padding: 14px 28px;
    text-decoration: none;
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
    z-index: 1;
    isolation: isolate;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-get-in-touch::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: var(--accent-color);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: -1;
  }

  .btn-get-in-touch:hover {
    color: #000000;
  }

  .btn-get-in-touch:hover::before {
    left: 0;
  }

  /* Bottom Bar Styling */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 60px;
    padding-top: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .copyright-text {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.4);
    font-family: 'Rajdhani', sans-serif;
    letter-spacing: 0.5px;
  }

  .payment-list {
    display: flex;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .payment-list-item svg {
    width: 38px;
    height: 24px;
    filter: grayscale(1) brightness(1.4) opacity(0.5);
    transition: all 0.3s ease;
  }

  .payment-list-item:hover svg {
    filter: grayscale(0) brightness(1) opacity(0.9);
  }

  @media screen and (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: 15px;
    }
  }
{% endstylesheet %}

