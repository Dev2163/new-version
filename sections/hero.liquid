{%- if section.settings.image != blank -%}
  <link rel="preload" as="image" href="{{ section.settings.image | image_url: width: 1000, format: 'webp' }}" imagesrcset="{{ section.settings.image | image_url: width: 375, format: 'webp' }} 375w, {{ section.settings.image | image_url: width: 550, format: 'webp' }} 550w, {{ section.settings.image | image_url: width: 750, format: 'webp' }} 750w, {{ section.settings.image | image_url: width: 1000, format: 'webp' }} 1000w, {{ section.settings.image | image_url: width: 1400, format: 'webp' }} 1400w" imagesizes="(min-width: 990px) 50vw, (min-width: 768px) 100vw, 85vw">
{%- endif -%}

<div class="custom-hero-container-{{ section.id }}">
  <!-- FIXED/STICKY CINEMATIC VIEWPORT STAGE -->
  <div class="hero-sticky-stage-{{ section.id }}">
    
    <!-- Large Background Typography Layer -->
    <div class="hero-editorial-bg-text-wrap-{{ section.id }}">
      <div class="hero-editorial-bg-text-1">Wear your</div>
      <div class="hero-editorial-bg-text-2">universe</div>
    </div>

    <!-- Left Vertical Indicator -->
    <div class="hero-left-indicator-{{ section.id }}">
      <div class="indicator-text-{{ section.id }}">
        <span>O</span><span>N</span><span>E</span><span>9</span>
      </div>
      <div class="indicator-icon-{{ section.id }}">
        <svg viewBox="0 0 40 40" width="32" height="32" fill="currentColor">
          <!-- Top dots -->
          <circle cx="12" cy="8" r="1.5" />
          <circle cx="20" cy="6" r="1.5" />
          <circle cx="28" cy="8" r="1.5" />
          <circle cx="35" cy="14" r="1.5" />
          <circle cx="5" cy="14" r="1.5" />
          <!-- Bottom dots -->
          <circle cx="12" cy="32" r="1.5" />
          <circle cx="20" cy="34" r="1.5" />
          <circle cx="28" cy="32" r="1.5" />
          <circle cx="35" cy="26" r="1.5" />
          <circle cx="5" cy="26" r="1.5" />
          
          <!-- Blinking Eye -->
          <g class="blinking-eye">
            <path d="M 0 20 Q 20 14 40 20 Q 20 26 0 20 Z" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="20" cy="20" r="3" fill="currentColor" />
          </g>
        </svg>
      </div>
      <div class="indicator-track-{{ section.id }}">
        <div class="indicator-progress-{{ section.id }}"></div>
      </div>
    </div>

    <!-- Pinned Visual campaign content -->
    <div class="hero-campaign-stage-{{ section.id }}">
      
      <!-- Central Model Image Container -->
      <div class="hero-model-viewport-{{ section.id }}">
        <div class="hero-image-wrapper-{{ section.id }}">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 1200 }}" id="heroMainImage" class="campaign-stage-img-{{ section.id }} is-active" data-index="0" alt="Campaign Focus">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'campaign-stage-img placeholder is-active' }}
          {%- endif -%}

          {% for block in section.blocks %}
            {% if block.type == 'thumbnail' %}
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 1200 }}" class="campaign-stage-img-{{ section.id }}" data-index="{{ forloop.index }}" alt="{{ block.settings.product_name | escape }}">
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
      


    </div>

    <!-- Bottom tab pills indicator (Fades in dynamically on scroll) -->
    <div class="campaign-bottom-nav-{{ section.id }}">
      <div class="campaign-nav-container-{{ section.id }}">
        <span class="campaign-nav-pill-{{ section.id }} is-active" data-index="0">Intro</span>
        {% for block in section.blocks %}
          {% if block.type == 'thumbnail' %}
            <span class="campaign-nav-pill-{{ section.id }}" data-index="{{ forloop.index }}">{{ block.settings.product_name }}</span>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  </div>
</div>

<style>
  /* Sticky Scroll Range Container */
  .custom-hero-container-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 480vh; /* scroll range distance for animation scrub */
    background-color: {{ section.settings.bg_color | default: '#0a0a0a' }};
  }

  /* Sticky Cinematic Viewport */
  .hero-sticky-stage-{{ section.id }} {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: {{ section.settings.bg_color | default: '#0a0a0a' }};
  }

  /* Left Vertical Indicator */
  .hero-left-indicator-{{ section.id }} {
    position: absolute;
    left: 40px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 50;
  }

  .indicator-text-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: -2px; /* Very tight spacing */
    font-family: 'Orbitron', 'Archivo Black', sans-serif;
    font-weight: 900;
    font-size: 32px;
    line-height: 0.9;
    color: {{ section.settings.accent_color | default: '#F4C430' }};
    text-shadow: 0 0 15px rgba(244, 196, 48, 0.6), 0 0 30px rgba(244, 196, 48, 0.3);
    margin-bottom: 35px;
  }

  .indicator-text-{{ section.id }} span {
    display: block;
  }

  .indicator-icon-{{ section.id }} {
    color: {{ section.settings.accent_color | default: '#F4C430' }};
    margin-bottom: 35px;
    filter: drop-shadow(0 0 8px rgba(244, 196, 48, 0.4));
  }

  .blinking-eye {
    transform-origin: 20px 20px;
    animation: eyeBlink 4s infinite;
  }

  @keyframes eyeBlink {
    0%, 90%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }

  .indicator-track-{{ section.id }} {
    width: 2px;
    height: 180px;
    background: rgba(255,255,255,0.1);
    position: relative;
    border-radius: 2px;
  }

  .indicator-progress-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background: {{ section.settings.accent_color | default: '#F4C430' }};
    border-radius: 2px;
    box-shadow: 0 0 10px {{ section.settings.accent_color | default: '#F4C430' }};
  }

  /* Massive Editorial Typography Layer (Behind Model) */
  .hero-editorial-bg-text-wrap-{{ section.id }} {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    text-align: center;
    padding-bottom: 40px;
  }
  
  .hero-editorial-bg-text-1,
  .hero-editorial-bg-text-2 {
    font-family: 'Orbitron', 'Archivo Black', sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.85;
    letter-spacing: -0.02em;
    user-select: none;
  }

  .hero-editorial-bg-text-1 {
    font-size: clamp(50px, 12vw, 170px);
    color: #ffffff;
    opacity: 1; /* Bright default */
    text-shadow: 0 0 30px rgba(255, 255, 255, 0.4), 0 0 70px rgba(255, 255, 255, 0.2); /* Glow effect */
  }

  .hero-editorial-bg-text-2 {
    font-size: clamp(45px, 10vw, 140px);
    color: transparent;
    -webkit-text-stroke: 2px rgba(255,255,255,0.75); /* Bright outline */
    opacity: 1;
  }

  /* Campaign Stage and Layout */
  .hero-campaign-stage-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  /* Model Viewport Frame - Portrait aspect ratio to fully fit models */
  .hero-model-viewport-{{ section.id }} {
    position: absolute;
    width: clamp(160px, 20vw, 290px); /* Reduced size */
    aspect-ratio: 0.68; /* Slightly less tall */
    z-index: 2;
    overflow: hidden;
    border-radius: 4px;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 25px 60px rgba(0,0,0,0.8);
    transition: box-shadow 0.5s ease;
  }

  .hero-image-wrapper-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .campaign-stage-img-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center; /* Prevents the head from being cut off */
    display: block;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transform: scale(1.02);
    z-index: 1;
  }

  .campaign-stage-img-{{ section.id }}.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
  }



  /* Bottom Pills Navigation Indicators */
  .campaign-bottom-nav-{{ section.id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 99;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .campaign-nav-container-{{ section.id }} {
    display: flex;
    background: rgba(10, 10, 10, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 40px;
    padding: 6px;
    gap: 6px;
  }

  .campaign-nav-pill-{{ section.id }} {
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #888888;
    padding: 10px 20px;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .campaign-nav-pill-{{ section.id }}.is-active,
  .campaign-nav-pill-{{ section.id }}:hover {
    background: #ffffff;
    color: #000000;
  }

  /* Responsive Adjustments */
  @media (max-width: 990px) {
    .hero-model-viewport-{{ section.id }} {
      width: clamp(200px, 40vw, 340px); /* Reduced for tablet */
    }
  }

  @media (max-width: 767px) {
    .hero-editorial-bg-text-wrap-{{ section.id }} {
      padding-bottom: 100px;
    }
    .hero-model-viewport-{{ section.id }} {
      width: clamp(180px, 55vw, 260px); /* Reduced for mobile */
      aspect-ratio: 0.72;
    }
    .hero-left-indicator-{{ section.id }} {
      display: none; /* Hide complex indicator on mobile to save space */
    }
    .campaign-bottom-nav-{{ section.id }} {
      bottom: 15px;
      width: 95%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      display: flex;
      justify-content: center;
    }
    .campaign-nav-container-{{ section.id }} {
      padding: 4px;
      gap: 4px;
      flex-wrap: nowrap;
    }
    .campaign-nav-pill-{{ section.id }} {
      padding: 8px 12px;
      font-size: 9px;
    }
  }
</style>

{% if section.blocks.size > 0 %}
<script>
  (function() {
    function initCampaignHero() {
      const container = document.querySelector('.custom-hero-container-{{ section.id }}');
      if (!container) return;

      const viewport = container.querySelector('.hero-model-viewport-{{ section.id }}');
      const bgText1 = container.querySelector('.hero-editorial-bg-text-1');
      const bgText2 = container.querySelector('.hero-editorial-bg-text-2');
      const bottomNav = container.querySelector('.campaign-bottom-nav-{{ section.id }}');
      const pills = container.querySelectorAll('.campaign-nav-pill-{{ section.id }}');
      const indicatorProgress = container.querySelector('.indicator-progress-{{ section.id }}');

      // Load steps data
      const blockData = [];
      {% for block in section.blocks %}
        {% if block.type == 'thumbnail' %}
          blockData.push({
            image: "{{ block.settings.image | image_url: width: 1200 }}",
            name: "{{ block.settings.product_name | escape }}",
            price: "{{ block.settings.price | escape }}",
            url: "{{ block.settings.product_url | default: '#' }}"
          });
        {% endif %}
      {% endfor %}

      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

      // 1. Entrance Initial Splash Reveal - Model first, then text stagger
      gsap.set(container, { opacity: 0 });
      gsap.set([bgText1, bgText2], { y: 40, opacity: 0 });
      
      gsap.timeline()
        .to(container, { opacity: 1, duration: 1.0, ease: "power2.out" })
        .to([bgText1, bgText2], { y: 0, opacity: 1, stagger: 0.3, duration: 1.2, ease: "power3.out" }, "-=0.4");

      // Helper function to smooth crossfade campaign image
      const glowWrapper = container.querySelector('.hero-image-wrapper-{{ section.id }}');
      // Layered static images list
      const stageImages = container.querySelectorAll('.campaign-stage-img-{{ section.id }}');
      function showImageAtIndex(idx) {
        stageImages.forEach(img => {
          if (parseInt(img.getAttribute('data-index')) === idx) {
            img.classList.add('is-active');
          } else {
            img.classList.remove('is-active');
          }
        });
      }

      // 2. Master Pinned Campaign Timeline (Scroll = Animation Timeline)
      const campaignTl = gsap.timeline({
        scrollTrigger: {
          trigger: container,
          start: "top top",
          end: "bottom bottom",
          scrub: 1.5 // Increased for buttery smooth cinematic delay
        }
      });

      // Step 1: Continuous Zoom & Parallax for model and background text
      campaignTl.to(viewport, { scale: 1.30, ease: "none" }, 0);
      campaignTl.to(bgText1, { yPercent: -12, ease: "none" }, 0);
      campaignTl.to(bgText2, { yPercent: 12, ease: "none" }, 0);
      campaignTl.to(bottomNav, { autoAlpha: 1, y: -10, duration: 0.3 }, 0.1);
      
      // Animate the vertical progress bar based on total timeline duration
      campaignTl.to(indicatorProgress, { height: "100%", ease: "none" }, 0);

      // Step 2 & 3: Staggered loops through the campaign blocks
      const stepsCount = blockData.length;
      if (stepsCount > 0) {
        blockData.forEach((data, index) => {
          campaignTl.to({}, {
            duration: 0.5,
            onStart: () => {
              showImageAtIndex(index + 1);

              gsap.killTweensOf([bgText1, bgText2], "opacity");
              // Cinematic morph transition of typography: fade out, swap, fade in
              gsap.timeline()
                .to([bgText1, bgText2], { opacity: 0, duration: 0.22, ease: "power2.inOut" })
                .call(() => {
                  const words = data.name.split(' ');
                  if (bgText1) bgText1.innerHTML = words[0] || "";
                  if (bgText2) bgText2.innerHTML = words.slice(1).join(' ') || "";
                })
                .to(bgText1, { opacity: 1, duration: 0.38, ease: "power3.out" })
                .to(bgText2, { opacity: 1, duration: 0.38, ease: "power3.out" }, "-=0.25");

              pills.forEach((p, pi) => {
                if (pi === index + 1) p.classList.add('is-active');
                else p.classList.remove('is-active');
              });
            },
            onReverseComplete: () => {
              gsap.killTweensOf([bgText1, bgText2], "opacity");
              
              if (index === 0) {
                // Restore intro splash with cinematic transition
                gsap.timeline()
                  .to([bgText1, bgText2], { opacity: 0, duration: 0.22, ease: "power2.inOut" })
                  .call(() => {
                    if (bgText1) bgText1.innerHTML = "Wear your";
                    if (bgText2) bgText2.innerHTML = "universe";
                    showImageAtIndex(0);
                  })
                  .to(bgText1, { opacity: 1, duration: 0.4, ease: "power3.out" })
                  .to(bgText2, { opacity: 1, duration: 0.4, ease: "power3.out" }, "-=0.2");
                
                pills.forEach((p, pi) => {
                  if (pi === 0) p.classList.add('is-active');
                  else p.classList.remove('is-active');
                });
              } else {
                const prev = blockData[index - 1];
                showImageAtIndex(index);

                gsap.timeline()
                  .to([bgText1, bgText2], { opacity: 0, duration: 0.22, ease: "power2.inOut" })
                  .call(() => {
                    const prevWords = prev.name.split(' ');
                    if (bgText1) bgText1.innerHTML = prevWords[0] || "";
                    if (bgText2) bgText2.innerHTML = prevWords.slice(1).join(' ') || "";
                  })
                  .to(bgText1, { opacity: 1, duration: 0.38, ease: "power3.out" })
                  .to(bgText2, { opacity: 1, duration: 0.38, ease: "power3.out" }, "-=0.25");

                pills.forEach((p, pi) => {
                  if (pi === index) p.classList.add('is-active');
                  else p.classList.remove('is-active');
                });
              }
            }
          }, stepProgressTime(index));
        });
      }

      function stepProgressTime(index) {
        // Returns percentage-mapped progression times
        return 0.8 + index * 0.9;
      }

      // Step 4: Final zoom toward the footwear focus (85% -> 100%)
      const lastTriggerPoint = 0.8 + (stepsCount - 1) * 0.9 + 0.4;
      campaignTl.to(viewport, {
        scale: 1.45,
        yPercent: -15, // Camera moves down looking toward shoes
        ease: "power2.inOut",
        duration: 1.0
      }, lastTriggerPoint);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCampaignHero);
    } else {
      initCampaignHero();
    }

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}' || event.target.querySelector('.custom-hero-container-{{ section.id }}')) {
        initCampaignHero();
      }
    });
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "ONE9 Cinematic Stage Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Initial Campaign Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#F4C430"
    }
  ],
  "blocks": [
    {
      "type": "thumbnail",
      "name": "Campaign Slide Block",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Model Image"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Model Name",
          "default": "Denim Defined"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Sub-label / Price",
          "default": "Model Showcase"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ONE9 Cinematic Stage Hero",
      "category": "Custom",
      "blocks": [
        { "type": "thumbnail", "settings": { "product_name": "Denim Defined", "price": "Model Showcase" } },
        { "type": "thumbnail", "settings": { "product_name": "Bold Baggy", "price": "Campaign Look 2" } },
        { "type": "thumbnail", "settings": { "product_name": "Cargo Classic", "price": "Campaign Look 3" } }
      ]
    }
  ]
}
{% endschema %}
