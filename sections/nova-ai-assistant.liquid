{% render 'nova-ai-assistant', 
  openrouter_api_key: section.settings.openrouter_api_key,
  openrouter_model: section.settings.openrouter_model
%}

{% schema %}
{
  "name": "NovaAI Shopping Assistant",
  "settings": [
    {
      "type": "text",
      "id": "openrouter_api_key",
      "label": "OpenRouter API Key",
      "info": "Paste your OpenRouter API Key here (starts with sk-or-) to enable real-time AI chat. If left blank, it falls back to the rule-based assistant."
    },
    {
      "type": "text",
      "id": "openrouter_model",
      "label": "OpenRouter Model ID",
      "default": "openrouter/free",
      "info": "e.g., openrouter/free, google/gemini-flash-1.5:free, meta-llama/llama-3.1-8b-instruct:free"
    }
  ],
  "presets": [
    {
      "name": "NovaAI Shopping Assistant"
    }
  ]
}
{% endschema %}
