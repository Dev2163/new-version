{% liquid
  assign heading = section.settings.heading | default: 'BEST SELLERS'
  assign view_all_text = section.settings.view_all_text | default: 'VIEW ALL PRODUCTS'
  assign view_all_link = section.settings.view_all_link | default: '/collections/all'
  assign products_limit = section.settings.products_limit | default: 7
  assign accent_color = section.settings.accent_color | default: '#F4C430'
  assign bg_color = section.settings.bg_color | default: '#0A0A0A'
  assign selected_collection = section.settings.collection
%}

{%- style -%}
  .best-sellers-sticky-wrapper-{{ section.id }} {
    position: relative;
    width: 100%;
    /* Dynamically calculate scroll height based on number of products */
    height: calc({{ products_limit | default: 6 }} * 50vh + 100vh);
    background-color: {{ bg_color }};
    --best-sellers-accent: {{ accent_color }};
  }

  .best-sellers-sticky-stage-{{ section.id }} {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: {{ bg_color }};
  }

  .best-sellers-container-{{ section.id }} {
    width: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
  }

  /* View All Float Link */
  .best-sellers__view-all-wrap-{{ section.id }} {
    position: absolute;
    top: 40px;
    right: 5%;
    z-index: 10;
  }

  .best-sellers__view-all-{{ section.id }} {
    color: var(--best-sellers-accent);
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: text-shadow 0.3s ease;
  }

  .best-sellers__view-all-{{ section.id }}:hover {
    text-shadow: 0 0 10px rgba(244, 196, 48, 0.7);
  }

  .best-sellers__view-all-icon-{{ section.id }} {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .best-sellers__view-all-{{ section.id }}:hover .best-sellers__view-all-icon-{{ section.id }} {
    transform: translateX(4px);
  }

  /* Editorial Background Text Layers (Behind grid) */
  .cinematic-text-layer-{{ section.id }} {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    overflow: hidden;
    text-align: center;
    box-sizing: border-box;
  }

  .cinematic-bg-text-wrap-{{ section.id }} {
    z-index: 1; /* Behind cards */
    align-items: {{ section.settings.bottom_text_align | default: 'flex-start' }};
    padding-left: 8%;
    padding-right: 8%;
  }

  .cinematic-fg-text-wrap-{{ section.id }} {
    z-index: 1; /* Behind cards */
    align-items: {{ section.settings.top_text_align | default: 'flex-start' }};
    padding-left: 8%;
    padding-right: 8%;
  }

  .cinematic-text-line-1-{{ section.id }},
  .cinematic-text-line-2-{{ section.id }} {
    font-family: 'Orbitron', 'Archivo Black', sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.85;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* Solid glow text ("BEST") */
  .cinematic-text-line-1-{{ section.id }} {
    font-size: clamp(40px, 8vw, 100px);
    color: #ffffff;
    text-shadow: 0 0 30px rgba(255, 255, 255, 0.4), 0 0 70px rgba(255, 255, 255, 0.2);
    margin-bottom: 12px;
  }

  /* Outline text ("SELLERS") */
  .cinematic-text-line-2-{{ section.id }} {
    font-size: clamp(35px, 7vw, 85px);
    color: transparent;
    -webkit-text-stroke: 2px rgba(255,255,255,0.75);
    margin-top: 12px;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
  }

  /* Horizontal Rail Grid (Sits on top of background texts) */
  .best-sellers__grid-{{ section.id }} {
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    gap: 40px;
    align-items: center;
    padding-left: 35vw; /* Initial offset so first card centers perfectly */
    padding-right: 35vw;
    will-change: transform;
    z-index: 2; /* Sits in front of background text */
    padding-block: 40px;
  }

  .best-sellers__card-{{ section.id }} {
    flex: 0 0 clamp(240px, 30vw, 360px);
    background-color: #111111;
    border: 1px solid #1E1E1E;
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s ease, 
                box-shadow 0.4s ease, 
                background-color 0.4s ease;
    will-change: transform;
  }

  .best-sellers__card-{{ section.id }}.is-active-card {
    border-color: var(--best-sellers-accent);
    box-shadow: 0 20px 40px rgba(244, 196, 48, 0.12);
    background-color: #151515;
  }

  .best-sellers__image-container-{{ section.id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 0.75;
    overflow: hidden;
    border-radius: 10px;
    margin-bottom: 18px;
    background: #181818;
  }

  .best-sellers__image-link-{{ section.id }} {
    display: block;
    width: 100%;
    height: 100%;
  }

  .best-sellers__image-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .best-sellers__image--secondary-{{ section.id }} {
    position: absolute;
    inset: 0;
    opacity: 0;
    z-index: 2;
  }

  .best-sellers__card-{{ section.id }}:hover .best-sellers__image--primary-{{ section.id }} {
    opacity: 0;
  }

  .best-sellers__card-{{ section.id }}:hover .best-sellers__image--secondary-{{ section.id }} {
    opacity: 1;
    transform: scale(1.03);
  }

  .best-sellers__card-{{ section.id }}:hover .best-sellers__image-{{ section.id }}:not(.best-sellers__image--secondary-{{ section.id }}) {
    transform: scale(1.03);
  }

  .best-sellers__wishlist-btn-{{ section.id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 5;
    background: rgba(10, 10, 10, 0.5);
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(4px);
  }

  .best-sellers__wishlist-btn-{{ section.id }}:hover {
    background: var(--best-sellers-accent);
    color: #000000;
    transform: scale(1.1);
  }

  .best-sellers__wishlist-btn-{{ section.id }} svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
  }

  .best-sellers__info-{{ section.id }} {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .best-sellers__title-link-{{ section.id }} {
    text-decoration: none;
    margin-bottom: 8px;
  }

  .best-sellers__title-{{ section.id }} {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 600;
    margin: 0;
    line-height: 1.4;
    transition: color 0.3s ease;
  }

  .best-sellers__title-{{ section.id }}:hover {
    color: var(--best-sellers-accent);
  }

  .best-sellers__price-{{ section.id }} {
    color: #E0E0E0;
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 12px 0;
  }

  .best-sellers__swatches-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
  }

  .best-sellers__swatch-{{ section.id }},
  .best-sellers__swatches-{{ section.id }} .swatch {
    display: inline-block;
    width: 14px !important;
    height: 14px !important;
    min-width: 14px !important;
    min-height: 14px !important;
    border-radius: 50% !important;
    border: 1px solid #444 !important;
    margin: 0 !important;
  }

  .best-sellers__swatches-more-{{ section.id }} {
    font-size: 10px;
    color: #888888;
    font-weight: 700;
    margin-left: 2px;
  }

  .best-sellers__image-placeholder-{{ section.id }} {
    width: 100%;
    height: 100%;
    background-color: #1A1A1A;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .best-sellers__placeholder-icon-{{ section.id }} {
    font-size: 32px;
    opacity: 0.5;
  }

  @media (max-width: 767px) {
    .best-sellers__grid-{{ section.id }} {
      padding-left: 25vw;
      padding-right: 25vw;
      gap: 20px;
    }
    .best-sellers__card-{{ section.id }} {
      flex: 0 0 clamp(220px, 60vw, 280px);
      padding: 14px;
    }
    .best-sellers__view-all-wrap-{{ section.id }} {
      top: 20px;
    }
    .cinematic-text-line-1-{{ section.id }} {
      font-size: clamp(40px, 10vw, 100px);
      margin-bottom: 10px;
    }
    .cinematic-text-line-2-{{ section.id }} {
      font-size: clamp(35px, 8vw, 80px);
      margin-top: 10px;
    }
  }
{%- endstyle -%}

<div class="best-sellers-sticky-wrapper-{{ section.id }}" id="BestSellersSticky-{{ section.id }}">
  <div class="best-sellers-sticky-stage-{{ section.id }}">
    <div class="best-sellers-container-{{ section.id }}">
      
      <!-- View All Button -->
      <div class="best-sellers__view-all-wrap-{{ section.id }}">
        <a href="{{ view_all_link }}" class="best-sellers__view-all-{{ section.id }}">
          {{- view_all_text -}}
          <svg class="best-sellers__view-all-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Background Text Layer (Behind Grid) -->
      <div class="cinematic-text-layer-{{ section.id }} cinematic-bg-text-wrap-{{ section.id }}">
        <div style="font-size: clamp(40px, 8vw, 100px); line-height: 0.85; margin-bottom: 12px; visibility: hidden;">Spacer</div>
        <div class="cinematic-text-line-2-{{ section.id }}">{{ section.settings.bg_text_bottom | default: 'SELLERS' }}</div>
      </div>

      <!-- Horizontal Grid of Products -->
      <div class="best-sellers__grid-{{ section.id }}">
        {% if selected_collection != blank and selected_collection.products_count > 0 %}
          {% for product in selected_collection.products limit: products_limit %}
            <div class="best-sellers__card-{{ section.id }}">
              
              <div class="best-sellers__image-container-{{ section.id }}">
                <button class="best-sellers__wishlist-btn-{{ section.id }}" aria-label="Add to wishlist">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </button>
                
                <a href="{{ product.url }}" class="best-sellers__image-link-{{ section.id }}">
                  {% if product.images.size > 1 %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | default: product.title }}"
                      loading="lazy"
                      class="best-sellers__image-{{ section.id }} best-sellers__image--primary-{{ section.id }}"
                    >
                    <img
                      src="{{ product.images[1] | image_url: width: 600 }}"
                      alt="{{ product.images[1].alt | default: product.title }}"
                      loading="lazy"
                      class="best-sellers__image-{{ section.id }} best-sellers__image--secondary-{{ section.id }}"
                    >
                  {% else %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | default: product.title }}"
                      loading="lazy"
                      class="best-sellers__image-{{ section.id }}"
                    >
                  {% endif %}
                </a>
              </div>

              <div class="best-sellers__info-{{ section.id }}">
                <a href="{{ product.url }}" class="best-sellers__title-link-{{ section.id }}">
                  <p class="best-sellers__title-{{ section.id }}">{{ product.title }}</p>
                </a>
                <p class="best-sellers__price-{{ section.id }}">{{ product.price | money }}</p>

                {%- liquid
                  assign color_option = nil
                  for option in product.options_with_values
                    assign name_downcase = option.name | downcase
                    if name_downcase contains 'color' or name_downcase contains 'colour' or name_downcase contains 'shade'
                      assign color_option = option
                      break
                    endif
                  endfor
                -%}
                
                {% if color_option != blank %}
                  <div class="best-sellers__swatches-{{ section.id }}">
                    {% for value in color_option.values limit: 3 %}
                      {% if value.swatch %}
                        {% render 'swatch', swatch: value.swatch, label: value.name %}
                      {% else %}
                        <span
                          class="best-sellers__swatch-{{ section.id }}"
                          style="background-color: {{ value.name | handle }};"
                          title="{{ value.name }}"
                        ></span>
                      {% endif %}
                    {% endfor %}
                    {% if color_option.values.size > 3 %}
                      <span class="best-sellers__swatches-more-{{ section.id }}">+{{ color_option.values.size | minus: 3 }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

            </div>
          {% endfor %}
        {% else %}
          {% for i in (1..products_limit) %}
            <div class="best-sellers__card-{{ section.id }}">
              <div class="best-sellers__image-container-{{ section.id }}">
                <div class="best-sellers__image-placeholder-{{ section.id }}">
                  <span class="best-sellers__placeholder-icon-{{ section.id }}">👕</span>
                </div>
              </div>
              <div class="best-sellers__info-{{ section.id }}">
                <p class="best-sellers__title-{{ section.id }}">Libra Balance Oversized Tee</p>
                <p class="best-sellers__price-{{ section.id }}">£45.00</p>
                <div class="best-sellers__swatches-{{ section.id }}">
                  <span class="best-sellers__swatch-{{ section.id }}" style="background-color: #556B2F;"></span>
                  <span class="best-sellers__swatch-{{ section.id }}" style="background-color: #111111;"></span>
                  <span class="best-sellers__swatch-{{ section.id }}" style="background-color: #8B4513;"></span>
                  <span class="best-sellers__swatches-more-{{ section.id }}">+2</span>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>

      <!-- Foreground Text Layer (Behind Grid, top line) -->
      <div class="cinematic-text-layer-{{ section.id }} cinematic-fg-text-wrap-{{ section.id }}">
        <div class="cinematic-text-line-1-{{ section.id }}">{{ section.settings.bg_text_top | default: 'BEST' }}</div>
      </div>

    </div>
  </div>
</div>

<script>
  (function() {
    function initBestSellers() {
      const section = document.getElementById('BestSellersSticky-{{ section.id }}');
      if (!section) return;

      const textLine1 = section.querySelector('.cinematic-text-line-1-{{ section.id }}');
      const textLine2 = section.querySelector('.cinematic-text-line-2-{{ section.id }}');
      const grid = section.querySelector('.best-sellers__grid-{{ section.id }}');
      const cards = section.querySelectorAll('.best-sellers__card-{{ section.id }}');

      if (!grid || cards.length === 0) return;
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

      // 1. Function to calculate card scaling dynamically based on distance from viewport center
      function updateCardScales() {
        const gridRect = grid.getBoundingClientRect();
        const gridCenterX = gridRect.left + gridRect.width / 2;

        cards.forEach(card => {
          const cardRect = card.getBoundingClientRect();
          const cardCenterX = cardRect.left + cardRect.width / 2;
          
          // Distance from screen horizontal center
          const distance = Math.abs(gridCenterX - cardCenterX);
          const maxDistance = gridRect.width / 2;
          
          const progress = Math.min(distance / maxDistance, 1); // 0 at center, 1 at edge
          
          // Scale from 1.08 (active center) down to 0.92 (edges)
          const scale = 1.08 - (progress * 0.16);
          card.style.transform = `scale(${scale})`;
          
          // Add active styling class to focused card
          if (progress < 0.22) {
            card.classList.add('is-active-card');
          } else {
            card.classList.remove('is-active-card');
          }
        });
      }

      // 2. Setup GSAP Horizontal Scroll Pinning
      gsap.registerPlugin(ScrollTrigger);

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "bottom bottom",
          scrub: 1.0,
          onUpdate: () => {
            // Recalculate card zoom factor on every page scroll update
            updateCardScales();
          }
        }
      });

      // Horizontal rail slide translation
      tl.to(grid, {
        x: () => -(grid.scrollWidth - window.innerWidth + window.innerWidth * 0.1),
        ease: "none"
      }, 0);

      // Background text parallax scrolling behind the rail!
      tl.to(textLine1, { xPercent: -15, ease: "none" }, 0);
      tl.to(textLine2, { xPercent: 15, ease: "none" }, 0);

      // Initial scaling run
      setTimeout(updateCardScales, 150);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBestSellers);
    } else {
      initBestSellers();
    }

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}' || event.target.querySelector('#BestSellersSticky-{{ section.id }}')) {
        initBestSellers();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Best Sellers Cinematic",
  "settings": [
    {
      "type": "text",
      "id": "bg_text_top",
      "label": "Top Text",
      "default": "BEST"
    },
    {
      "type": "text",
      "id": "bg_text_bottom",
      "label": "Bottom Text",
      "default": "SELLERS"
    },
    {
      "type": "select",
      "id": "top_text_align",
      "label": "Top Text Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "bottom_text_align",
      "label": "Bottom Text Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Product Limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 7
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#F4C430"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Cinematic"
    }
  ]
}
{% endschema %}
