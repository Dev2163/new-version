{% comment %}
  ONE9 — Premium Preloader / Splash Screen
  Shows once per session (or always in test mode)
  Controlled via theme settings
{% endcomment %}

{%- if section.settings.enabled -%}
<div
  id="one9-preloader"
  class="one9-preloader"
  data-once="{{ section.settings.show_once_per_session }}"
  data-all-pages="{{ section.settings.show_on_all_pages }}"
  data-test="{{ section.settings.test_mode }}"
  data-max-wait="{{ section.settings.max_wait_time | default: 2500 }}"
  aria-hidden="true"
  role="presentation"
>

  {%- comment -%} ── Background ── {%- endcomment -%}
  <div class="pre-bg"></div>

  {%- comment -%} ── Grid Lines ── {%- endcomment -%}
  <div class="pre-grid" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
  </div>

  {%- comment -%} ── Corner Brackets ── {%- endcomment -%}
  <div class="pre-corner pre-corner--tl" aria-hidden="true"></div>
  <div class="pre-corner pre-corner--tr" aria-hidden="true"></div>
  <div class="pre-corner pre-corner--bl" aria-hidden="true"></div>
  <div class="pre-corner pre-corner--br" aria-hidden="true"></div>

  {%- comment -%} ── Center Content ── {%- endcomment -%}
  <div class="pre-center">

    {%- comment -%} Logo / Wordmark {%- endcomment -%}
    <div class="pre-logo" id="pre-logo">
      {%- if section.settings.logo_image != blank -%}
        <img
          src="{{ section.settings.logo_image | image_url: width: 260 }}"
          alt="{{ section.settings.logo_text | default: 'ONE9' }}"
          width="200"
          height="80"
          style="max-width:200px; height:auto;"
        >
      {%- else -%}
        <span class="pre-logo-text">
          {{ section.settings.logo_text | default: 'ONE9' }}
        </span>
      {%- endif -%}
    </div>

    {%- comment -%} Animated Line {%- endcomment -%}
    <div class="pre-line-wrap" id="pre-line-wrap">
      <div class="pre-line-track">
        <div class="pre-line-fill" id="pre-line-fill"></div>
      </div>
      <div class="pre-pct" id="pre-pct">0%</div>
    </div>

    {%- comment -%} Tagline {%- endcomment -%}
    {%- if section.settings.tagline_text != blank -%}
      {%- assign tagline_words = section.settings.tagline_text | split: ' ' -%}
      <p class="pre-tagline" id="pre-tagline">
        {%- for word in tagline_words -%}
          <span class="pre-word">{{ word }}</span>
        {%- endfor -%}
      </p>
    {%- endif -%}

  </div>

  {%- comment -%} ── Reveal Curtain ── {%- endcomment -%}
  <div class="pre-curtain pre-curtain--top" id="pre-curtain-top"></div>
  <div class="pre-curtain pre-curtain--bot" id="pre-curtain-bot"></div>

</div>
{%- endif -%}

<style>
  /* ══════════════════════════════════════════════════════════
     ONE9 PRELOADER — CSS
  ══════════════════════════════════════════════════════════ */

  /* Hide page body scroll while loading */
  body.pre-loading {
    overflow: hidden;
  }

  .one9-preloader {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: all;
  }

  /* ── Background ── */
  .pre-bg {
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.bg_color | default: '#0a0a0a' }};
    z-index: 0;
  }

  /* ── Grid Lines ── */
  .pre-grid {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-between;
    z-index: 1;
    pointer-events: none;
  }
  .pre-grid span {
    display: block;
    width: 1px;
    height: 100%;
    background: rgba(255,255,255,0.04);
  }

  /* ── Corner Brackets ── */
  .pre-corner {
    position: absolute;
    width: 36px;
    height: 36px;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .pre-corner--tl { top: 24px;    left: 24px;    border-top: 2px solid {{ section.settings.line_color | default: '#f4c430' }};  border-left:  2px solid {{ section.settings.line_color | default: '#f4c430' }};  }
  .pre-corner--tr { top: 24px;    right: 24px;   border-top: 2px solid {{ section.settings.line_color | default: '#f4c430' }};  border-right: 2px solid {{ section.settings.line_color | default: '#f4c430' }};  }
  .pre-corner--bl { bottom: 24px; left: 24px;    border-bottom: 2px solid {{ section.settings.line_color | default: '#f4c430' }}; border-left:  2px solid {{ section.settings.line_color | default: '#f4c430' }};  }
  .pre-corner--br { bottom: 24px; right: 24px;   border-bottom: 2px solid {{ section.settings.line_color | default: '#f4c430' }}; border-right: 2px solid {{ section.settings.line_color | default: '#f4c430' }};  }
  .one9-preloader.pre-active .pre-corner { opacity: 1; }

  /* ── Center ── */
  .pre-center {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
    padding: 0 24px;
  }

  /* ── Logo ── */
  .pre-logo {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22,1,0.36,1);
  }
  .pre-logo.pre-in {
    opacity: 1;
    transform: translateY(0);
  }
  .pre-logo-text {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(52px, 10vw, 96px);
    font-weight: 900;
    letter-spacing: -2px;
    color: {{ section.settings.logo_color | default: '#f4c430' }};
    line-height: 1;
    display: block;
    text-shadow: 0 0 40px rgba(244,196,48,0.35);
  }

  /* ── Progress Line ── */
  .pre-line-wrap {
    width: clamp(200px, 40vw, 360px);
    opacity: 0;
    transform: scaleX(0.6);
    transition: opacity 0.5s ease 0.3s, transform 0.5s ease 0.3s;
  }
  .pre-line-wrap.pre-in {
    opacity: 1;
    transform: scaleX(1);
  }
  .pre-line-track {
    width: 100%;
    height: 2px;
    background: rgba(255,255,255,0.1);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }
  .pre-line-fill {
    position: absolute;
    top: 0; left: 0;
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, {{ section.settings.line_color | default: '#f4c430' }} 0%, #ffdd70 100%);
    border-radius: 2px;
    box-shadow: 0 0 12px rgba(244,196,48,0.6);
    transition: width 0.08s linear;
  }
  .pre-pct {
    margin-top: 10px;
    font-family: 'Orbitron', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    color: {{ section.settings.line_color | default: '#f4c430' }};
    opacity: 0.7;
    text-align: right;
  }

  /* ── Tagline ── */
  .pre-tagline {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    font-family: 'Rajdhani', sans-serif;
    font-size: clamp(12px, 1.8vw, 15px);
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: {{ section.settings.tagline_color | default: '#8a7b5c' }};
    margin: 0;
  }
  .pre-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22,1,0.36,1);
  }
  .pre-word.pre-in {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Curtains (exit animation) ── */
  .pre-curtain {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50%;
    background-color: {{ section.settings.bg_color | default: '#0a0a0a' }};
    z-index: 4;
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 0.6s cubic-bezier(0.76,0,0.24,1);
    pointer-events: none;
  }
  .pre-curtain--top { top: 0;    transform-origin: top; }
  .pre-curtain--bot { bottom: 0; transform-origin: bottom; }

  /* Curtain exit state */
  .one9-preloader.pre-exit .pre-curtain--top { transform: scaleY(1); }
  .one9-preloader.pre-exit .pre-curtain--bot { transform: scaleY(1); }

  /* Hidden state — remove from layout */
  .one9-preloader.pre-done {
    display: none;
    pointer-events: none;
  }

  /* ── Reduced Motion ── */
  @media (prefers-reduced-motion: reduce) {
    .one9-preloader { display: none !important; }
    body.pre-loading { overflow: auto; }
  }
</style>

<script>
(function () {
  'use strict';

  var STORAGE_KEY = 'one9_preloader_shown';
  var el          = document.getElementById('one9-preloader');
  if (!el) return;

  var oncePerSession = el.dataset.once   === 'true';
  var allPages       = el.dataset.allPages === 'true';
  var testMode       = el.dataset.test    === 'true';
  var maxWait        = parseInt(el.dataset.maxWait, 10) || 2500;

  /* ── Decide whether to show ── */
  var isHomePage = window.location.pathname === '/' || window.location.pathname === '';

  if (!testMode) {
    // Skip if not homepage and show_on_all_pages is off
    if (!allPages && !isHomePage) {
      el.classList.add('pre-done');
      return;
    }
    // Skip if shown this session already
    if (oncePerSession && sessionStorage.getItem(STORAGE_KEY)) {
      el.classList.add('pre-done');
      return;
    }
  }

  /* ── Lock scroll ── */
  document.body.classList.add('pre-loading');

  /* ── Elements ── */
  var logo       = document.getElementById('pre-logo');
  var lineWrap   = document.getElementById('pre-line-wrap');
  var lineFill   = document.getElementById('pre-line-fill');
  var pctEl      = document.getElementById('pre-pct');
  var tagline    = document.getElementById('pre-tagline');
  var curtainTop = document.getElementById('pre-curtain-top');
  var curtainBot = document.getElementById('pre-curtain-bot');

  /* ── Activate corners ── */
  el.classList.add('pre-active');

  /* ── Stagger logo & line in ── */
  setTimeout(function () {
    if (logo)     logo.classList.add('pre-in');
    if (lineWrap) lineWrap.classList.add('pre-in');
  }, 80);

  /* ── Stagger tagline words in ── */
  if (tagline) {
    var words = tagline.querySelectorAll('.pre-word');
    words.forEach(function (w, i) {
      setTimeout(function () { w.classList.add('pre-in'); }, 300 + i * 80);
    });
  }

  /* ── Fake progress counter ── */
  var pct       = 0;
  var startTime = Date.now();
  var duration  = Math.min(maxWait * 0.75, 1800); // 75% of maxWait for fake fill

  function animatePct() {
    var elapsed  = Date.now() - startTime;
    var progress = Math.min(elapsed / duration, 1);
    // Ease out cubic
    var eased    = 1 - Math.pow(1 - progress, 3);
    pct          = Math.round(eased * 95); // Cap at 95; jump to 100 on done

    if (lineFill) lineFill.style.width = pct + '%';
    if (pctEl)    pctEl.textContent    = pct + '%';

    if (progress < 1) {
      requestAnimationFrame(animatePct);
    }
  }
  requestAnimationFrame(animatePct);

  /* ── Dismiss ── */
  function dismiss() {
    // Jump to 100%
    if (lineFill) lineFill.style.width = '100%';
    if (pctEl)    pctEl.textContent    = '100%';

    // Brief pause then curtain exit
    setTimeout(function () {
      el.classList.add('pre-exit');

      // After curtain closes, remove preloader
      setTimeout(function () {
        el.classList.add('pre-done');
        document.body.classList.remove('pre-loading');
        if (oncePerSession && !testMode) {
          sessionStorage.setItem(STORAGE_KEY, '1');
        }
      }, 680);
    }, 260);
  }

  /* ── Trigger dismiss when page is ready or maxWait exceeded ── */
  var dismissed = false;
  function triggerDismiss() {
    if (dismissed) return;
    dismissed = true;
    dismiss();
  }

  // Window load event (all resources ready)
  if (document.readyState === 'complete') {
    setTimeout(triggerDismiss, 300);
  } else {
    window.addEventListener('load', function () {
      setTimeout(triggerDismiss, 300);
    });
  }

  // Hard fallback: never exceed maxWait
  setTimeout(triggerDismiss, maxWait);
})();
</script>

{% schema %}
{
  "name": "Preloader",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Preloader",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_once_per_session",
      "label": "Show once per session",
      "info": "Uses sessionStorage — shows again on new tab/window",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_all_pages",
      "label": "Show on all pages",
      "info": "Off = homepage only",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "test_mode",
      "label": "Test mode (always show)",
      "info": "Turn off before publishing",
      "default": false
    },
    {
      "type": "range",
      "id": "max_wait_time",
      "min": 800,
      "max": 6000,
      "step": 200,
      "unit": "ms",
      "label": "Max wait time",
      "info": "Preloader auto-dismisses after this duration even if page hasn't loaded",
      "default": 2400
    },
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image",
      "info": "Leave blank to use text logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "ONE9"
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Tagline",
      "default": "BUILT DIFFERENT. WORN EVERYWHERE."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo Color",
      "default": "#f4c430"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Progress Line Color",
      "default": "#f4c430"
    },
    {
      "type": "color",
      "id": "tagline_color",
      "label": "Tagline Color",
      "default": "#8a7b5c"
    }
  ],
  "presets": [
    {
      "name": "Preloader"
    }
  ]
}
{% endschema %}
