{% comment %}
  ONE9 Luxury Streetwear - Contact & Support Section (Gold, Black & White Palette)
{% endcomment %}

<div class="main-contact section-{{ section.id }}" style="background-color: #050505; color: #ffffff; padding: 60px 0;">
  <div class="page-width">
    <!-- Heading -->
    <div style="text-align: center; max-width: 700px; margin: 0 auto 56px auto;">
      <span style="font-family: 'Rajdhani', sans-serif; font-size: 14px; font-weight: 700; color: #f4c430; letter-spacing: 2.5px; text-transform: uppercase;">24/7 CONCIERGE & SUPPORT</span>
      <h1 style="font-family: 'Orbitron', sans-serif; font-size: clamp(30px, 5vw, 48px); font-weight: 900; text-transform: uppercase; margin: 12px 0 18px 0; color: #ffffff; letter-spacing: 1px; text-shadow: 0 0 15px rgba(255, 255, 255, 0.1);">
        GET IN TOUCH
      </h1>
      <p style="font-family: 'Rajdhani', sans-serif; font-size: 16px; color: #a0a0a0;">
        Have questions about sizing, orders, or worldwide shipping? Our client support team is here to assist you.
      </p>
    </div>

    <!-- 2-Column Responsive Layout -->
    <div class="contact-grid">
      
      <!-- Left Column: Info & FAQs -->
      <div style="display: flex; flex-direction: column; gap: 32px;">
        
        <!-- Contact Channels Cards -->
        <div style="display: flex; flex-direction: column; gap: 20px;">
          <!-- Direct WhatsApp -->
          <div class="glass-panel" style="padding: 24px; border-radius: 12px; display: flex; align-items: center; gap: 18px; transition: border-color 0.3s;">
            <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(37, 211, 102, 0.12); color: #25D366; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
            </div>
            <div>
              <div style="font-family: 'Orbitron', sans-serif; font-size: 14px; font-weight: 700; color: #ffffff; letter-spacing: 0.5px;">WHATSAPP VIP CHAT</div>
              <div style="font-family: 'Rajdhani', sans-serif; font-size: 13px; color: #a0a0a0; margin-top: 2px;">Instant responses for VIP inquiries</div>
              <a href="https://wa.me/447000000000" target="_blank" style="color: #25D366; font-family: 'Rajdhani', sans-serif; font-size: 13px; font-weight: 700; text-decoration: none; margin-top: 6px; display: inline-block;">Message on WhatsApp &rarr;</a>
            </div>
          </div>

          <!-- Email Concierge -->
          <div class="glass-panel" style="padding: 24px; border-radius: 12px; display: flex; align-items: center; gap: 18px; transition: border-color 0.3s;">
            <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(244, 196, 48, 0.12); color: #f4c430; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div>
              <div style="font-family: 'Orbitron', sans-serif; font-size: 14px; font-weight: 700; color: #ffffff; letter-spacing: 0.5px;">CLIENT CARE EMAIL</div>
              <div style="font-family: 'Rajdhani', sans-serif; font-size: 13px; color: #a0a0a0; margin-top: 2px;">support@one9clothing.com</div>
              <a href="mailto:support@one9clothing.com" style="color: #f4c430; font-family: 'Rajdhani', sans-serif; font-size: 13px; font-weight: 700; text-decoration: none; margin-top: 6px; display: inline-block;">Send an Email &rarr;</a>
            </div>
          </div>
        </div>

        <!-- FAQ Accordion -->
        <div class="glass-panel" style="padding: 32px; border-radius: 12px;">
          <h3 style="font-family: 'Orbitron', sans-serif; font-size: 16px; font-weight: 800; color: #ffffff; text-transform: uppercase; margin-bottom: 24px; letter-spacing: 1px;">
            FREQUENTLY ASKED QUESTIONS
          </h3>
          <div style="display: flex; flex-direction: column; gap: 18px;">
            <details style="border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 14px;">
              <summary style="font-family: 'Orbitron', sans-serif; font-size: 12px; font-weight: 700; color: #f4c430; cursor: pointer; outline: none; list-style: none;">
                ✦ WHAT IS THE SHIPPING TIME FOR ORDERS?
              </summary>
              <p style="font-family: 'Rajdhani', sans-serif; font-size: 14px; color: #b0b0b0; margin-top: 10px; line-height: 1.6;">
                Domestic express orders take 1-3 business days. International orders typically arrive within 3-7 business days via priority DHL/FedEx.
              </p>
            </details>

            <details style="border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 14px;">
              <summary style="font-family: 'Orbitron', sans-serif; font-size: 12px; font-weight: 700; color: #f4c430; cursor: pointer; outline: none; list-style: none;">
                ✦ HOW DO I RETURN OR EXCHANGE AN ITEM?
              </summary>
              <p style="font-family: 'Rajdhani', sans-serif; font-size: 14px; color: #b0b0b0; margin-top: 10px; line-height: 1.6;">
                We offer a 30-day money-back return policy. Simply submit your order number in our online returns portal.
              </p>
            </details>

            <details style="border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 14px;">
              <summary style="font-family: 'Orbitron', sans-serif; font-size: 12px; font-weight: 700; color: #f4c430; cursor: pointer; outline: none; list-style: none;">
                ✦ ARE YOUR PRODUCTS 100% ORIGINAL?
              </summary>
              <p style="font-family: 'Rajdhani', sans-serif; font-size: 14px; color: #b0b0b0; margin-top: 10px; line-height: 1.6;">
                Yes, all ONE9 products are 100% original, designed in-house and manufactured with custom serial authentication tags.
              </p>
            </details>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="glass-panel" style="padding: 40px; border-radius: 12px;">
        <h3 style="font-family: 'Orbitron', sans-serif; font-size: 18px; font-weight: 800; color: #ffffff; text-transform: uppercase; margin-bottom: 24px; letter-spacing: 1px;">
          SEND A MESSAGE
        </h3>
        
        {%- form 'contact', id: 'ContactForm', class: 'contact-form-style' -%}
          {%- if form.posted_successfully? -%}
            <div class="form-status form-status-success" tabindex="-1" autofocus style="color: #25D366; font-family: 'Rajdhani', sans-serif; font-weight: 700; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Thanks for contacting us. We'll get back to you shortly!
            </div>
          {%- elsif form.errors -%}
            <div class="form-status form-status-error" style="color: #ff4d4d; font-family: 'Rajdhani', sans-serif; font-weight: 700; margin-bottom: 20px;">
              <h2 style="font-size: 16px; margin: 0 0 8px 0;">Please adjust the following:</h2>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="input-group">
            <label for="ContactForm-name" class="input-label">YOUR NAME</label>
            <input type="text" id="ContactForm-name" name="contact[name]" class="theme-input" placeholder="Enter your full name" required>
          </div>

          <div class="input-group">
            <label for="ContactForm-email" class="input-label">YOUR EMAIL</label>
            <input type="email" id="ContactForm-email" name="contact[email]" class="theme-input" placeholder="Enter your email address" required>
          </div>

          <div class="input-group">
            <label for="ContactForm-phone" class="input-label">PHONE NUMBER</label>
            <input type="tel" id="ContactForm-phone" name="contact[phone]" class="theme-input" placeholder="Enter your phone number (optional)">
          </div>

          <div class="input-group">
            <label for="ContactForm-body" class="input-label">MESSAGE / INQUIRY</label>
            <textarea id="ContactForm-body" name="contact[body]" rows="6" class="theme-input theme-textarea" placeholder="How can we help you?" required></textarea>
          </div>

          <button type="submit" class="submit-btn-gold">SEND MESSAGE</button>
        {%- endform -%}
      </div>

    </div>
  </div>
</div>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 990px) {
    .contact-grid {
      grid-template-columns: 1fr 1.2fr;
    }
  }
  .theme-input {
    width: 100%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 14px 16px;
    color: #ffffff;
    font-family: 'Rajdhani', sans-serif;
    font-size: 15px;
    font-weight: 500;
    outline: none;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }
  .theme-input:focus {
    border-color: #f4c430;
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 0 10px rgba(244, 196, 48, 0.15);
  }
  .input-group {
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .input-label {
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #a0a0a0;
  }
  .theme-textarea {
    resize: vertical;
    min-height: 120px;
  }
  .submit-btn-gold {
    width: 100%;
    background: linear-gradient(135deg, #f4c430 0%, #D4A017 100%);
    color: #000000;
    border: none;
    border-radius: 8px;
    padding: 16px 20px;
    font-family: 'Orbitron', sans-serif;
    font-weight: 900;
    font-size: 14px;
    letter-spacing: 1.5px;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(244, 196, 48, 0.3);
    transition: all 0.3s ease;
    text-transform: uppercase;
  }
  .submit-btn-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(244, 196, 48, 0.5);
    background: linear-gradient(135deg, #FFD700 0%, #f4c430 100%);
  }
  .glass-panel:hover {
    border-color: rgba(244, 196, 48, 0.2) !important;
  }
  details summary::-webkit-details-marker {
    display: none;
  }
</style>

{% schema %}
{
  "name": "Contact & Support",
  "presets": [
    {
      "name": "Contact & Support"
    }
  ]
}
{% endschema %}
