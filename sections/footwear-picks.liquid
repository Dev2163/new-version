{% liquid
  assign heading = section.settings.heading | default: 'FOOTWEAR PICKS'
  assign view_all_text = section.settings.view_all_text | default: 'VIEW ALL'
  assign view_all_link = section.settings.view_all_link | default: '/collections/all'
%}

<div id="shoes" class="footwear-picks-wrapper">
  <div class="footwear-picks section-padding">
    <div class="footwear-picks__header">
      <h2 class="footwear-picks__heading">{{ heading }}</h2>
      <a href="{{ view_all_link }}" class="footwear-picks__view-all">{{ view_all_text }} &rarr;</a>
    </div>

    <div class="footwear-picks__grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        <div class="footwear-picks__card" {{ block.shopify_attributes }}>
          {% if product != blank %}
            <a href="{{ product.url }}" class="footwear-picks__image-wrapper">
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | default: product.title }}"
                loading="lazy"
                class="footwear-picks__image"
              >
            </a>
            <div class="footwear-picks__info">
              <a href="{{ product.url }}" class="footwear-picks__title-link">
                <h3 class="footwear-picks__title">{{ product.title }}</h3>
              </a>
              <p class="footwear-picks__price">{{ product.price | money }}</p>
              {% if product.options_with_values.size > 0 %}
                <div class="footwear-picks__swatches">
                  {% for value in product.options_with_values.first.values %}
                    {% if value.swatch %}
                      {% render 'swatch', swatch: value.swatch, label: value.name %}
                    {% else %}
                      <span
                        class="footwear-picks__swatch"
                        style="background-color: {{ value.name | handle }};"
                        title="{{ value.name }}"
                      ></span>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% else %}
            <div class="footwear-picks__placeholder">
              <p>Select a product in the theme editor &rarr;</p>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .footwear-picks-wrapper {
    background-color: #0A0A0A;
    width: 100%;
  }

  .footwear-picks {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding-inline: var(--page-margin, 20px);
    padding-block: 50px;
  }

  .footwear-picks__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 16px;
  }

  .footwear-picks__heading {
    color: #FFFFFF;
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(20px, 3vw, 26px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
  }

  .footwear-picks__view-all {
    color: #F4C430;
    font-family: 'Rajdhani', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .footwear-picks__view-all:hover {
    text-shadow: 0 0 10px rgba(244, 196, 48, 0.7);
    transform: translateX(4px);
  }

  .footwear-picks__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  @media (max-width: 850px) {
    .footwear-picks__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .footwear-picks__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .footwear-picks__card {
      flex-direction: column;
      text-align: center;
      padding: 20px 16px;
      gap: 16px;
    }

    .footwear-picks__image-wrapper {
      width: 100%;
      max-width: 280px;
      height: 160px;
      margin: 0 auto;
    }

    .footwear-picks__info {
      width: 100%;
      align-items: center;
      text-align: center;
    }

    .footwear-picks__title {
      font-size: 15px;
      text-align: center;
      margin-bottom: 6px;
    }

    .footwear-picks__price {
      font-size: 16px;
      text-align: center;
      margin-bottom: 8px;
    }

    .footwear-picks__swatches {
      justify-content: center;
    }
  }

  .footwear-picks__card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 16px;
    padding: 14px 20px;
    display: flex;
    gap: 16px;
    align-items: center;
    width: 100%;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .footwear-picks__card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(244, 196, 48, 0.45);
    transform: translateY(-4px);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 25px rgba(244, 196, 48, 0.15);
  }

  .footwear-picks__image-wrapper {
    width: 260px;
    height: 165px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    position: relative;
    background: #ffffff;
    border-radius: 12px;
    padding: 4px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footwear-picks__image {
    max-width: 115%;
    max-height: 115%;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(1.15);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .footwear-picks__card:hover .footwear-picks__image-wrapper {
    box-shadow: 0 8px 25px rgba(244, 196, 48, 0.35);
  }

  .footwear-picks__card:hover .footwear-picks__image {
    transform: scale(1.28) rotate(-3deg) translateY(-2px);
  }

  .footwear-picks__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .footwear-picks__title-link {
    text-decoration: none;
  }

  .footwear-picks__title {
    color: #FFFFFF;
    font-family: 'Orbitron', sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 1.4;
    margin: 0 0 8px 0;
    transition: color 0.3s ease;
  }

  .footwear-picks__card:hover .footwear-picks__title {
    color: #F4C430;
  }

  .footwear-picks__price {
    color: #F4C430;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 18px;
    margin: 0 0 10px 0;
    transition: text-shadow 0.3s ease;
  }

  .footwear-picks__card:hover .footwear-picks__price {
    text-shadow: 0 0 8px rgba(244, 196, 48, 0.6);
  }

  .footwear-picks__swatches {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }

  .footwear-picks__swatch,
  .footwear-picks__swatches .swatch {
    display: inline-block;
    width: 16px !important;
    height: 16px !important;
    min-width: 16px !important;
    min-height: 16px !important;
    border-radius: 50% !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    margin: 0 !important;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .footwear-picks__swatch:hover {
    transform: scale(1.2);
    border-color: #F4C430 !important;
  }

  .footwear-picks__placeholder {
    color: #888;
    font-size: 15px;
    padding: 45px 0;
    text-align: center;
    width: 100%;
  }
</style>

{% schema %}
{
  "name": "Footwear Picks",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FOOTWEAR PICKS"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All button text",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All link (collection page)"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footwear Picks",
      "blocks": [
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
