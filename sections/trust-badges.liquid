{% liquid
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
  assign icon_color = section.settings.icon_color | default: '#F4C430'
%}

<div class="trust-badges-wrapper" style="background-color: {{ bg_color }};">
  <div class="trust-badges page-width">
    <div class="trust-badges__grid">
      {% for block in section.blocks %}
        <div class="trust-badge__item" {{ block.shopify_attributes }}>
          <div class="trust-badge__icon-wrapper">
            <div class="trust-badge__icon-glow"></div>
            <div class="trust-badge__icon" style="color: {{ icon_color }};">
              {% if block.settings.custom_svg != blank %}
                {{ block.settings.custom_svg }}
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              {% endif %}
            </div>
          </div>
          <div class="trust-badge__content">
            <h4 class="trust-badge__title" style="color: {{ text_color }};">{{ block.settings.title }}</h4>
            <p class="trust-badge__subtitle" style="color: {{ text_color | color_modify: 'alpha', 0.7 }};">{{ block.settings.subtitle }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .trust-badges-wrapper {
    width: 100%;
    padding: 32px 0;
    position: relative;
    border-top: 1px solid rgba(244, 196, 48, 0.15);
    border-bottom: 1px solid rgba(244, 196, 48, 0.15);
    background: radial-gradient(circle at 50% 50%, rgba(244, 196, 48, 0.03) 0%, transparent 80%);
    overflow: hidden;
  }

  .trust-badges {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .trust-badges__grid {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    gap: 20px;
  }

  .trust-badge__item {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: 1;
    position: relative;
    padding: 20px 24px;
    background: rgba(18, 18, 18, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    cursor: default;
    overflow: hidden;
  }

  .trust-badge__item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(244, 196, 48, 0.12) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  /* Hover Effects */
  .trust-badge__item:hover {
    background: rgba(26, 26, 26, 0.85);
    border-color: rgba(244, 196, 48, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(244, 196, 48, 0.15);
  }

  .trust-badge__item:hover::before {
    opacity: 1;
  }

  .trust-badge__icon-wrapper {
    position: relative;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(244, 196, 48, 0.08);
    border: 1px solid rgba(244, 196, 48, 0.25);
    border-radius: 10px;
    transition: all 0.4s ease;
  }

  .trust-badge__item:hover .trust-badge__icon-wrapper {
    background: rgba(244, 196, 48, 0.18);
    border-color: #F4C430;
    transform: scale(1.08) rotate(3deg);
    box-shadow: 0 0 15px rgba(244, 196, 48, 0.3);
  }

  .trust-badge__icon-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    background: #F4C430;
    filter: blur(10px);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .trust-badge__item:hover .trust-badge__icon-glow {
    opacity: 0.25;
  }

  .trust-badge__icon {
    width: 24px;
    height: 24px;
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .trust-badge__icon svg {
    width: 100%;
    height: 100%;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .trust-badge__item:hover .trust-badge__icon svg {
    transform: scale(1.1);
  }

  .trust-badge__content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
    z-index: 2;
  }

  .trust-badge__title {
    font-family: "Orbitron", "Rajdhani", var(--font-heading-family, sans-serif);
    font-size: 13px;
    font-weight: 800;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .trust-badge__item:hover .trust-badge__title {
    color: #FFFFFF !important;
    text-shadow: 0 0 10px rgba(244, 196, 48, 0.5);
  }

  .trust-badge__subtitle {
    font-size: 12px;
    margin: 0;
    line-height: 1.4;
    letter-spacing: 0.2px;
  }

  /* Responsive Design - Tablet */
  @media screen and (max-width: 1024px) {
    .trust-badges__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  /* Responsive Design - Mobile */
  @media screen and (max-width: 640px) {
    .trust-badges-wrapper {
      padding: 24px 0;
    }
    .trust-badges__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .trust-badge__item {
      padding: 16px;
    }
    .trust-badge__icon-wrapper {
      width: 40px;
      height: 40px;
    }
    .trust-badge__icon {
      width: 20px;
      height: 20px;
    }
    .trust-badge__title {
      font-size: 12px;
    }
    .trust-badge__subtitle {
      font-size: 11px;
    }
  }
</style>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#F4C430"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
