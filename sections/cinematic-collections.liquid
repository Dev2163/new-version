{%- style -%}
  .cinematic-collections-wrapper-{{ section.id }} {
    position: relative;
    width: 100%;
    /* Dynamically set height based on number of blocks for scrolling distance */
    height: calc({{ section.blocks.size | plus: 1 }} * 100vh);
    background-color: {{ section.settings.bg_color }};
  }

  .cinematic-sticky-stage-{{ section.id }} {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: {{ section.settings.bg_color }};
  }

  /* Large Background/Foreground Typography Wrapper */
  .cinematic-text-layer-{{ section.id }} {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    overflow: hidden;
    text-align: center;
  }

  .cinematic-bg-text-wrap-{{ section.id }} {
    z-index: 1; /* Behind cards */
    align-items: {{ section.settings.bottom_text_align | default: 'center' }};
    padding-left: 8%;
    padding-right: 8%;
  }

  .cinematic-fg-text-wrap-{{ section.id }} {
    z-index: 1; /* Both lines of text now sit behind the cards */
    align-items: {{ section.settings.top_text_align | default: 'flex-start' }};
    padding-left: 8%;
    padding-right: 8%;
  }

  .cinematic-text-line-1-{{ section.id }},
  .cinematic-text-line-2-{{ section.id }} {
    font-family: 'Orbitron', 'Archivo Black', sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.85;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* Solid glowing text (Top Line, Foreground) */
  .cinematic-text-line-1-{{ section.id }} {
    font-size: clamp(50px, 12vw, 170px);
    color: #ffffff;
    text-shadow: 0 0 30px rgba(255, 255, 255, 0.4), 0 0 70px rgba(255, 255, 255, 0.2);
    margin-bottom: 20px;
  }

  /* Outline text (Bottom Line, Background) */
  .cinematic-text-line-2-{{ section.id }} {
    font-size: clamp(45px, 10vw, 140px);
    color: transparent;
    -webkit-text-stroke: 2px rgba(255,255,255,0.75);
    margin-top: 20px;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
  }

  /* Stack Container */
  .cinematic-stack-container-{{ section.id }} {
    position: relative;
    width: clamp(160px, 20vw, 290px); /* Matches Hero sizing */
    aspect-ratio: 0.68;
    z-index: 2; /* Sits between text layers */
    perspective: 1000px;
  }

  /* Individual Cards */
  .cinematic-card-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-origin: center bottom;
    will-change: transform, opacity;
  }

  .cinematic-card-inner-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 4px; /* Matches Hero's subtle rounding */
    overflow: hidden;
    background: #111111;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 25px 60px rgba(0,0,0,0.8);
    display: flex;
    flex-direction: column;
  }

  /* Card Image */
  .cinematic-card-img-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* Card Content Overlay */
  .cinematic-card-overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 40%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
    box-sizing: border-box;
    color: #ffffff;
  }

  .cinematic-card-title-{{ section.id }} {
    font-family: 'Oswald', 'Archivo Black', sans-serif;
    font-size: clamp(16px, 2vw, 24px); /* Optimized to fit narrow cards */
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    line-height: 1.2;
    margin: 0 0 12px 0;
    text-shadow: 0 2px 10px rgba(0,0,0,0.6);
    word-break: keep-all; /* Prevents splitting words mid-letter */
    overflow-wrap: break-word; /* Allows safe word wrapping */
  }

  .cinematic-card-link-{{ section.id }} {
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
    font-weight: 700;
    color: {{ section.settings.accent_color | default: '#F4C430' }};
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    display: inline-block;
    transition: 0.3s;
    width: fit-content;
  }

  .cinematic-card-link-{{ section.id }}:hover {
    color: #ffffff;
  }

  /* Dots Navigation */
  .cinematic-dots-{{ section.id }} {
    position: absolute;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 4;
  }

  .cinematic-dot-{{ section.id }} {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: rgba(255,255,255,0.3);
    transition: 0.3s;
  }

  .cinematic-dot-{{ section.id }}.is-active {
    background-color: {{ section.settings.accent_color | default: '#F4C430' }};
    transform: scale(1.5);
    box-shadow: 0 0 10px {{ section.settings.accent_color | default: '#F4C430' }};
  }

  @media (max-width: 767px) {
    .cinematic-stack-container-{{ section.id }} {
      width: clamp(180px, 55vw, 260px);
      aspect-ratio: 0.72;
    }
    .cinematic-dots-{{ section.id }} {
      right: 15px;
    }
    .cinematic-text-line-1-{{ section.id }} {
      font-size: clamp(40px, 10vw, 100px);
      margin-bottom: 10px;
    }
    .cinematic-text-line-2-{{ section.id }} {
      font-size: clamp(35px, 8vw, 80px);
      margin-top: 10px;
    }
  }
{%- endstyle -%}

<div class="cinematic-collections-wrapper-{{ section.id }}" id="CinematicCollections-{{ section.id }}">
  <div class="cinematic-sticky-stage-{{ section.id }}">
    
    <!-- Background Text Layer (Behind Cards) -->
    <div class="cinematic-text-layer-{{ section.id }} cinematic-bg-text-wrap-{{ section.id }}">
      <!-- Empty space spacer to push the second line below the cards -->
      <div style="font-size: clamp(50px, 12vw, 170px); line-height: 0.85; margin-bottom: 20px; visibility: hidden;">Spacer</div>
      <div class="cinematic-text-line-2-{{ section.id }}">{{ section.settings.bg_text_bottom | default: 'COLLECTIONS' }}</div>
    </div>

    <!-- Cards Stack Stage -->
    <div class="cinematic-stack-container-{{ section.id }}">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        {% assign img = block.settings.image | default: collection.featured_image %}
        
        <div class="cinematic-card-{{ section.id }}" 
             data-index="{{ forloop.index0 }}" 
             style="z-index: {{ section.blocks.size | minus: forloop.index0 }};"
             {{ block.shopify_attributes }}>
          <div class="cinematic-card-inner-{{ section.id }}">
            {% if img != blank %}
              <img src="{{ img | image_url: width: 800 }}" class="cinematic-card-img-{{ section.id }}" alt="{{ collection.title | escape }}">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'cinematic-card-img-wrapper placeholder' }}
            {% endif %}
            <div class="cinematic-card-overlay-{{ section.id }}">
              <h2 class="cinematic-card-title-{{ section.id }}">
                {{ block.settings.custom_title | default: collection.title | default: 'Collection' }}
              </h2>
              <a href="{{ collection.url | default: '#' }}" class="cinematic-card-link-{{ section.id }}">
                {{ block.settings.button_text | default: 'Explore Collection' }}
              </a>
            </div>
          </div>
        </div>
      {% endfor %}
      
      {% if section.blocks.size == 0 %}
        <div class="cinematic-card-{{ section.id }}" style="z-index: 1;">
          <div class="cinematic-card-inner-{{ section.id }}">
            {{ 'collection-1' | placeholder_svg_tag: 'cinematic-card-img placeholder' }}
            <div class="cinematic-card-overlay-{{ section.id }}">
              <h2 class="cinematic-card-title-{{ section.id }}">Collection Title</h2>
              <a href="#" class="cinematic-card-link-{{ section.id }}">Explore Collection</a>
            </div>
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Foreground Text Layer (In front of Cards) -->
    <div class="cinematic-text-layer-{{ section.id }} cinematic-fg-text-wrap-{{ section.id }}">
      <div class="cinematic-text-line-1-{{ section.id }}">{{ section.settings.bg_text_top | default: 'OUR' }}</div>
    </div>

    <!-- Dots -->
    <div class="cinematic-dots-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="cinematic-dot-{{ section.id }} {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}"></div>
      {% endfor %}
    </div>

  </div>
</div>

<script>
  (function() {
    function initCinematicCollections() {
      const section = document.getElementById('CinematicCollections-{{ section.id }}');
      if (!section) return;

      const textLine1 = section.querySelector('.cinematic-text-line-1-{{ section.id }}');
      const textLine2 = section.querySelector('.cinematic-text-line-2-{{ section.id }}');
      const cards = section.querySelectorAll('.cinematic-card-{{ section.id }}');
      const dots = section.querySelectorAll('.cinematic-dot-{{ section.id }}');

      if (cards.length <= 1) return; // Need multiple cards for stack animation
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

      // 1. Initial Stack Setup (stagger cards backward with scaling and rotation)
      cards.forEach((card, idx) => {
        if (idx > 0) {
          const scale = 1 - (idx * 0.04);
          const translateY = idx * 12;
          const rotation = idx % 2 === 0 ? 3 : -3;
          gsap.set(card, {
            scale: scale,
            y: translateY,
            rotation: rotation
          });
        }
      });

      // 2. Timeline Trigger for Pinned Fly-off
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "bottom bottom",
          scrub: 1.0
        }
      });

      // Parallax text scrolling in opposite directions!
      tl.to(textLine1, { xPercent: -15, ease: "none" }, 0);
      tl.to(textLine2, { xPercent: 15, ease: "none" }, 0);

      function updateActiveDot(activeIdx) {
        dots.forEach((dot, dIdx) => {
          if (dIdx === activeIdx) dot.classList.add('is-active');
          else dot.classList.remove('is-active');
        });
      }

      // Fly off cards one by one
      cards.forEach((card, idx) => {
        if (idx < cards.length - 1) {
          const triggerTime = idx;

          // Slide top card UP and out
          tl.to(card, {
            yPercent: -130,
            rotation: idx % 2 === 0 ? -12 : 12,
            opacity: 0,
            ease: "power1.inOut",
            duration: 1,
            onStart: () => updateActiveDot(idx + 1),
            onReverseComplete: () => updateActiveDot(idx)
          }, triggerTime);

          // Shift the rest of the stack forward
          for (let nextIdx = idx + 1; nextIdx < cards.length; nextIdx++) {
            const nextCard = cards[nextIdx];
            const relativeStackPos = nextIdx - (idx + 1); // New rank in stack
            
            const newScale = 1 - (relativeStackPos * 0.04);
            const newTranslateY = relativeStackPos * 12;
            const newRotation = relativeStackPos === 0 ? 0 : (nextIdx % 2 === 0 ? 3 : -3);

            tl.to(nextCard, {
              scale: newScale,
              y: newTranslateY,
              rotation: newRotation,
              ease: "power1.inOut",
              duration: 1
            }, triggerTime);
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCinematicCollections);
    } else {
      initCinematicCollections();
    }

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initCinematicCollections();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Cinematic Collections",
  "settings": [
    {
      "type": "text",
      "id": "bg_text_top",
      "label": "Top Text (Foreground)",
      "default": "OUR"
    },
    {
      "type": "text",
      "id": "bg_text_bottom",
      "label": "Bottom Text (Background)",
      "default": "COLLECTIONS"
    },
    {
      "type": "select",
      "id": "top_text_align",
      "label": "Top Text Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "bottom_text_align",
      "label": "Bottom Text Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#F4C430"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override Image (Optional)"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (Optional)",
          "info": "Overrides the default collection title text"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Link Text",
          "default": "Explore Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cinematic Collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
