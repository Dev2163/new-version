{% comment %}
  ONE9 / WORN WORLDWIDE — Pinned Scroll Staged Showcase
  Inspired by premium agency grid layouts (Tints Studio style)
  The section pins on scroll, and cards reveal/exit one-by-one.
{% endcomment %}

<!-- Cursive Google Font for Signature -->
<link href="https://fonts.googleapis.com/css2?family=Herr+Von+Muellerhoff&display=swap" rel="stylesheet">

{% liquid
  assign bg_color         = section.settings.bg_color         | default: '#080808'
  assign text_color       = section.settings.text_color       | default: '#ffffff'
  assign heading_text     = section.settings.heading_text     | default: 'ONE9 IS A LUXURY STREETWEAR STUDIO EMPOWERING INDIVIDUALS TO SHAPE THE FUTURE OF STREET CULTURE.'
  assign signature_text   = section.settings.signature_text   | default: 'One9. Studio'
%}

<section
  class="ww-parallax-section section-{{ section.id }}"
  id="ww-parallax-{{ section.id }}"
  style="background-color: {{ bg_color }}; color: {{ text_color }};"
  aria-label="Worn Worldwide"
>
  {%- comment -%} Subtle dot grid background pattern {%- endcomment -%}
  <div class="ww-grid-bg" aria-hidden="true"></div>

  <div class="ww-parallax-container">
    
    {%- comment -%} ── Central Main Heading ── {%- endcomment -%}
    <div class="ww-center-content">
      <h2 class="ww-main-heading">
        {{ heading_text }}
      </h2>
      {%- if signature_text != blank -%}
        <div class="ww-signature">
          {{ signature_text }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Pinned Parallax Cards ── {%- endcomment -%}
    <div class="ww-cards-wrapper">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {% liquid
            assign speed        = block.settings.speed | default: 1
            assign left         = block.settings.desktop_left | default: 10
            assign top          = block.settings.desktop_top | default: 10
            assign width        = block.settings.card_width | default: 20
            assign card_style   = block.settings.card_style | default: 'light'
          %}
          <div
            class="ww-floating-card ww-style-{{ card_style }} block-{{ block.id }}"
            data-speed="{{ speed }}"
            style="--desktop-left: {{ left }}%; --desktop-top: {{ top }}%; --card-width: {{ width }}%;"
            {{ block.shopify_attributes }}
          >
            <div class="ww-card-inner">
              
              {%- if card_style == 'light' or card_style == 'dark' or card_style == 'glass' -%}
                {%- comment -%} Top Bar metadata & number {%- endcomment -%}
                <div class="ww-card-top-bar">
                  <span class="ww-card-meta-desc">{{ block.settings.meta_description }}</span>
                  {%- if block.settings.show_number and block.settings.number != blank -%}
                    <span class="ww-card-num">{{ block.settings.number }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- comment -%} Main Card Media {%- endcomment -%}
              <div class="ww-card-image-box">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.title | default: 'ONE9 Showcase' }}"
                    loading="lazy"
                    width="800"
                    height="1000"
                  >
                {%- else -%}
                  <div class="ww-card-image-placeholder">
                    {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              {%- if card_style == 'light' or card_style == 'dark' or card_style == 'glass' -%}
                {%- comment -%} Bottom Bar title {%- endcomment -%}
                <div class="ww-card-bottom-bar">
                  <h3 class="ww-card-caption-title">{{ block.settings.title }}</h3>
                </div>
              {%- endif -%}

            </div>
          </div>
        {%- endfor -%}

      {%- else -%}
        {%- comment -%} Demo cards looking exactly like the agency showcase screenshot {%- endcomment -%}
        
        <!-- Card 1: Tote (Left column, Mid-Top) -->
        <div class="ww-floating-card ww-style-dark" data-speed="0.8" style="--desktop-left: 10%; --desktop-top: 15%; --card-width: 24%;">
          <div class="ww-card-inner">
            <div class="ww-card-image-box">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="ww-card-bottom-bar">
              <h3 class="ww-card-caption-title">Par Swam Tote</h3>
            </div>
          </div>
        </div>

        <!-- Card 2: Pants (Right column, Top) -->
        <div class="ww-floating-card ww-style-light" data-speed="-1.2" style="--desktop-left: 68%; --desktop-top: 5%; --card-width: 25%;">
          <div class="ww-card-inner">
            <div class="ww-card-top-bar">
              <span class="ww-card-meta-desc">Heavyweight premium twill cotton fit.</span>
              <span class="ww-card-num">01</span>
            </div>
            <div class="ww-card-image-box">
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="ww-card-bottom-bar">
              <h3 class="ww-card-caption-title">Imogene + Willie Studio</h3>
            </div>
          </div>
        </div>

        <!-- Card 3: Jeans Close-up (Center Column, top offset) -->
        <div class="ww-floating-card ww-style-image_only" data-speed="1.8" style="--desktop-left: 42%; --desktop-top: 10%; --card-width: 18%;">
          <div class="ww-card-inner">
            <div class="ww-card-image-box">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
        </div>

        <!-- Card 4: Business Card style (Left Column, bottom) -->
        <div class="ww-floating-card ww-style-dark" data-speed="-0.7" style="--desktop-left: 12%; --desktop-top: 48%; --card-width: 20%;">
          <div class="ww-card-inner">
            <div class="ww-card-image-box">
              {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="ww-card-bottom-bar">
              <h3 class="ww-card-caption-title">Par Swam Branding</h3>
            </div>
          </div>
        </div>

        <!-- Card 5: Mobile Screen (Right Column, bottom) -->
        <div class="ww-floating-card ww-style-image_only" data-speed="1.5" style="--desktop-left: 70%; --desktop-top: 45%; --card-width: 22%;">
          <div class="ww-card-inner">
            <div class="ww-card-image-box">
              {{ 'lifestyle-3' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
        </div>

      {%- endif -%}
    </div>

  </div>
</section>

<style>
  /* ── Section Wrapper & Grid Background ── */
  .ww-parallax-section {
    position: relative;
    overflow: hidden;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ww-grid-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1.2px, transparent 1.2px);
    background-size: 32px 32px;
    opacity: 0.8;
    pointer-events: none;
    z-index: 1;
  }

  .ww-parallax-container {
    position: absolute;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Central Headline ── */
  .ww-center-content {
    position: relative;
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
    z-index: 3;
    pointer-events: none;
  }

  .ww-main-heading {
    font-family: 'Orbitron', 'Inter', sans-serif;
    font-size: clamp(24px, 4.2vw, 44px);
    font-weight: 800;
    line-height: 1.25;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 20px 0;
    letter-spacing: -0.5px;
    word-wrap: break-word;
  }

  .ww-signature {
    font-family: 'Herr Von Muellerhoff', cursive;
    font-size: clamp(48px, 6vw, 72px);
    color: #f4c430;
    line-height: 1;
    margin-top: 10px;
    transform: rotate(-3deg);
  }

  /* ── Floating Cards ── */
  .ww-cards-wrapper {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .ww-floating-card {
    position: absolute;
    left: var(--desktop-left);
    top: var(--desktop-top);
    width: var(--card-width);
    pointer-events: auto;
    will-change: transform;
    opacity: 0; /* Animated via GSAP */
  }

  .ww-card-inner {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  }

  .ww-card-image-box {
    width: 100%;
    overflow: hidden;
    background: #111;
  }

  .ww-card-image-box img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .ww-floating-card:hover .ww-card-image-box img {
    transform: scale(1.04);
  }

  .ww-card-image-placeholder {
    width: 100%;
    aspect-ratio: 4/5;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
  }
  
  .ww-card-image-placeholder svg {
    width: 60%;
    height: 60%;
    opacity: 0.15;
  }

  /* ── Card Style Variations ── */

  /* Light Card Style */
  .ww-style-light .ww-card-inner {
    background: #f7f7f7;
    color: #111111;
  }
  .ww-style-light .ww-card-top-bar {
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }
  .ww-style-light .ww-card-meta-desc {
    font-family: 'Rajdhani', sans-serif;
    font-size: 11px;
    line-height: 1.3;
    font-weight: 600;
    color: #666666;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .ww-style-light .ww-card-num {
    font-family: 'Orbitron', sans-serif;
    font-size: 14px;
    font-weight: 800;
    color: #111111;
  }
  .ww-style-light .ww-card-bottom-bar {
    padding: 16px 20px;
  }
  .ww-style-light .ww-card-caption-title {
    font-family: 'Orbitron', 'Rajdhani', sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    color: #111111;
    margin: 0;
  }

  /* Dark Card Style */
  .ww-style-dark .ww-card-inner {
    background: #121212;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .ww-style-dark .ww-card-top-bar {
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }
  .ww-style-dark .ww-card-meta-desc {
    font-family: 'Rajdhani', sans-serif;
    font-size: 11px;
    line-height: 1.3;
    font-weight: 600;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .ww-style-dark .ww-card-num {
    font-family: 'Orbitron', sans-serif;
    font-size: 14px;
    font-weight: 800;
    color: #f4c430;
  }
  .ww-style-dark .ww-card-bottom-bar {
    padding: 16px 20px;
  }
  .ww-style-dark .ww-card-caption-title {
    font-family: 'Orbitron', 'Rajdhani', sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
  }

  /* Glass Card Style */
  .ww-style-glass .ww-card-inner {
    background: rgba(255, 255, 255, 0.03);
    color: #ffffff;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .ww-style-glass .ww-card-top-bar {
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }
  .ww-style-glass .ww-card-meta-desc {
    font-family: 'Rajdhani', sans-serif;
    font-size: 11px;
    line-height: 1.3;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .ww-style-glass .ww-card-num {
    font-family: 'Orbitron', sans-serif;
    font-size: 14px;
    font-weight: 800;
    color: #f4c430;
  }
  .ww-style-glass .ww-card-bottom-bar {
    padding: 16px 20px;
  }
  .ww-style-glass .ww-card-caption-title {
    font-family: 'Orbitron', 'Rajdhani', sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
  }

  /* Image Only Style */
  .ww-style-image_only .ww-card-inner {
    background: transparent;
    box-shadow: 0 12px 50px rgba(0, 0, 0, 0.5);
  }
  .ww-style-image_only .ww-card-image-box {
    border-radius: 16px;
  }

  /* ── Responsive Mobile States ── */
  @media (max-width: 991px) {
    .ww-floating-card {
      width: calc(var(--card-width) * 1.25);
    }
  }

  @media (max-width: 768px) {
    .ww-parallax-section {
      height: auto;
      min-height: auto;
      padding: 80px 0;
      display: block;
    }

    .ww-parallax-container {
      position: relative;
      padding: 0 20px;
      height: auto;
      display: block;
    }

    .ww-cards-wrapper {
      position: relative;
      inset: auto;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin-top: 48px;
      pointer-events: auto;
    }

    .ww-floating-card {
      position: relative;
      left: auto !important;
      top: auto !important;
      width: 100% !important;
      transform: none !important;
      opacity: 1 !important; /* Always visible on mobile grid */
    }

    .ww-style-image_only {
      grid-column: span 1;
    }

    .ww-floating-card:nth-child(3) {
      grid-column: span 2;
    }
  }
</style>

<script>
(function() {
  'use strict';

  function initParallaxShowcase() {
    const section = document.querySelector('.ww-parallax-section');
    if (!section || typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

    // Disable desktop pinning timeline on mobile to preserve layout
    const isMobile = window.innerWidth <= 768;
    if (isMobile) return;

    const cards = Array.from(section.querySelectorAll('.ww-floating-card'));
    if (!cards.length) return;

    // Create a pinned timeline
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "+=220%",
        scrub: 1.2,
        pin: true,
        anticipatePin: 1
      }
    });

    if (cards.length >= 4) {
      // 1. Initial State Settings (All cards offscreen or transparent)
      // Card 1 & 2 start below the view
      gsap.set([cards[0], cards[1]], { y: "100vh", opacity: 0 });
      // Card 3 starts above the view
      gsap.set(cards[2], { y: "-100vh", opacity: 0 });
      // Card 4 starts below the view
      gsap.set(cards[3], { y: "100vh", opacity: 0 });
      
      // If there is a 5th card, set it below too
      if (cards[4]) {
        gsap.set(cards[4], { y: "100vh", opacity: 0 });
      }

      // 2. Timeline Sequence animations mapping the scroll phases
      tl
        // Phase 1: Card 1 & 2 glide in from bottom
        .to([cards[0], cards[1]], { y: "0vh", opacity: 1, duration: 1.5, ease: "power2.out" })
        .to({}, { duration: 0.8 }) // Hold phase 1

        // Phase 2: Card 1 & 2 exit upwards, Card 3 glides down from top
        .to([cards[0], cards[1]], { y: "-100vh", opacity: 0, duration: 1.5, ease: "power2.in" })
        .to(cards[2], { y: "0vh", opacity: 1, duration: 1.5, ease: "power2.out" }, "<")
        .to({}, { duration: 0.8 }) // Hold phase 2

        // Phase 3: Card 3 exits upwards, Card 4 (and 5) glide up from bottom
        .to(cards[2], { y: "-100vh", opacity: 0, duration: 1.5, ease: "power2.in" });

      if (cards[4]) {
        tl.to([cards[3], cards[4]], { y: "0vh", opacity: 1, duration: 1.5, ease: "power2.out" }, "<")
          .to({}, { duration: 0.8 }) // Hold phase 3
          .to([cards[3], cards[4]], { y: "-100vh", opacity: 0, duration: 1.2, ease: "power2.in" });
      } else {
        tl.to(cards[3], { y: "0vh", opacity: 1, duration: 1.5, ease: "power2.out" }, "<")
          .to({}, { duration: 0.8 }) // Hold phase 3
          .to(cards[3], { y: "-100vh", opacity: 0, duration: 1.2, ease: "power2.in" });
      }

    } else {
      // Simple fallback stagger if there are fewer than 4 cards
      cards.forEach((card, i) => {
        gsap.set(card, { y: "100vh", opacity: 0 });
        tl.to(card, { y: "0vh", opacity: 1, duration: 1.5, ease: "power2.out" })
          .to({}, { duration: 0.6 })
          .to(card, { y: "-100vh", opacity: 0, duration: 1.5, ease: "power2.in" });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initParallaxShowcase);
  } else {
    initParallaxShowcase();
  }

  document.addEventListener('shopify:section:load', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      initParallaxShowcase();
    }
  });

  window.addEventListener('resize', function() {
    ScrollTrigger.refresh();
  });
})();
</script>

{% schema %}
{
  "name": "Worn Worldwide",
  "settings": [
    {
      "type": "textarea",
      "id": "heading_text",
      "label": "Heading Text",
      "default": "ONE9 IS A LUXURY STREETWEAR STUDIO EMPOWERING INDIVIDUALS TO SHAPE THE FUTURE OF STREET CULTURE."
    },
    {
      "type": "text",
      "id": "signature_text",
      "label": "Signature Word",
      "default": "One9. Studio"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#080808"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Floating Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Imogene + Willie Studio"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Corner Number",
          "default": "01"
        },
        {
          "type": "checkbox",
          "id": "show_number",
          "label": "Show Number",
          "default": true
        },
        {
          "type": "textarea",
          "id": "meta_description",
          "label": "Top Metadata",
          "default": "Heavyweight premium cotton construction."
        },
        {
          "type": "select",
          "id": "card_style",
          "label": "Card Style",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "dark", "label": "Dark" },
            { "value": "glass", "label": "Frosted Glass" },
            { "value": "image_only", "label": "Image Only (No text)" }
          ],
          "default": "light"
        },
        {
          "type": "range",
          "id": "speed",
          "min": -3.0,
          "max": 3.0,
          "step": 0.1,
          "label": "Parallax Speed",
          "info": "Negative values move in opposite scroll direction",
          "default": 1.0
        },
        {
          "type": "range",
          "id": "desktop_left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Desktop Left Offset",
          "default": 20
        },
        {
          "type": "range",
          "id": "desktop_top",
          "min": -20,
          "max": 80,
          "step": 1,
          "unit": "%",
          "label": "Desktop Top Offset",
          "default": 20
        },
        {
          "type": "range",
          "id": "card_width",
          "min": 10,
          "max": 50,
          "step": 1,
          "unit": "%",
          "label": "Desktop Width",
          "default": 20
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Worn Worldwide",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Imogene + Willie Studio",
            "number": "01",
            "card_style": "light",
            "speed": -1.2,
            "desktop_left": 68,
            "desktop_top": 5,
            "card_width": 25
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Par Swam Tote",
            "number": "02",
            "card_style": "dark",
            "speed": 0.8,
            "desktop_left": 10,
            "desktop_top": 15,
            "card_width": 24
          }
        },
        {
          "type": "card",
          "settings": {
            "card_style": "image_only",
            "speed": 1.8,
            "desktop_left": 42,
            "desktop_top": 10,
            "card_width": 18
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Par Swam Branding",
            "number": "03",
            "card_style": "dark",
            "speed": -0.7,
            "desktop_left": 12,
            "desktop_top": 48,
            "card_width": 20
          }
        },
        {
          "type": "card",
          "settings": {
            "card_style": "image_only",
            "speed": 1.5,
            "desktop_left": 70,
            "desktop_top": 45,
            "card_width": 22
          }
        }
      ]
    }
  ]
}
{% endschema %}
