{% comment %}
  ONE9 / WORN WORLDWIDE — Scroll-Stacked Card Deck Section
  Inspired by cinematic agency layouts: cards fan out on scroll
{% endcomment %}

{% liquid
  assign bg_color      = section.settings.bg_color      | default: '#e8e6e1'
  assign text_color    = section.settings.text_color     | default: '#111111'
  assign heading_text  = section.settings.title          | default: 'WORN WORLDWIDE'
  assign sub_text      = section.settings.subtitle       | default: 'COMMUNITY & CULTURE'
%}

<section
  class="worn-worldwide-section section-{{ section.id }}"
  id="worn-worldwide-{{ section.id }}"
  aria-label="{{ heading_text }}"
>

  {%- comment -%} ── Giant Background Letterform ── {%- endcomment -%}
  <div class="ww-bg-text" aria-hidden="true">
    {{ section.settings.bg_word | default: 'WORN WORLDWIDE' }}
  </div>

  {%- comment -%} ── Section Label ── {%- endcomment -%}
  <div class="ww-label-row">
    <span class="ww-eyebrow">{{ sub_text }}</span>
    <span class="ww-eyebrow">{{ heading_text }}</span>
  </div>

  {%- comment -%} ── Sticky Card Stack ── {%- endcomment -%}
  <div class="ww-stack-wrapper">
    <div class="ww-cards-pin">

      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div
            class="ww-card"
            data-index="{{ forloop.index0 }}"
            data-total="{{ section.blocks.size }}"
            {{ block.shopify_attributes }}
          >
            <div class="ww-card-inner">
              <div class="ww-card-media">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.title | default: heading_text }}"
                    loading="lazy"
                    width="800"
                    height="600"
                  >
                {%- else -%}
                  <div class="ww-card-placeholder">
                    {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>
              <div class="ww-card-body">
                {%- if block.settings.title != blank -%}
                  <h3 class="ww-card-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="ww-card-text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}

      {%- else -%}
        {%- comment -%} ── Default Demo Cards ── {%- endcomment -%}
        {%- assign demo_titles = 'Community Drops,Global Streets,Creative Collabs,Culture & Kicks' | split: ',' -%}
        {%- assign demo_texts = 'From Tokyo to Lagos — ONE9 is made for every timezone.,Spotted in 80+ cities worldwide. This is streetwear without borders.,Art meets apparel. Our collabs redefine the culture.,Where sneaker culture and luxury streetwear collide.' | split: ',' -%}
        {%- for i in (1..4) -%}
          {%- assign demo_product = collections.all.products[forloop.index0] -%}
          <div
            class="ww-card"
            data-index="{{ forloop.index0 }}"
            data-total="4"
          >
            <div class="ww-card-inner">
              <div class="ww-card-media">
                {%- if demo_product and demo_product.featured_media -%}
                  <img
                    src="{{ demo_product.featured_media | image_url: width: 800 }}"
                    alt="{{ demo_titles[forloop.index0] }}"
                    loading="lazy"
                    width="800"
                    height="600"
                  >
                {%- else -%}
                  <div class="ww-card-placeholder">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>
              <div class="ww-card-body">
                <h3 class="ww-card-title">{{ demo_titles[forloop.index0] }}</h3>
                <p class="ww-card-text">{{ demo_texts[forloop.index0] }}</p>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}

    </div>
  </div>

</section>

<style>
  /* ── Base ── */
  .worn-worldwide-section {
    position: relative;
    background-color: {{ bg_color }};
    color: {{ text_color }};
    overflow: hidden;
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 120 }}px;
    min-height: 100vh;
  }

  /* ── Giant BG Word ── */
  .ww-bg-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(60px, 11vw, 140px);
    font-family: 'Orbitron', 'Rajdhani', sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(0, 0, 0, 0.06);
    pointer-events: none;
    user-select: none;
    z-index: 0;
    letter-spacing: -2px;
    line-height: 1;
  }

  /* ── Label Row ── */
  .ww-label-row {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 clamp(20px, 5vw, 80px);
    margin-bottom: clamp(40px, 6vw, 80px);
  }

  .ww-eyebrow {
    font-family: 'Rajdhani', 'Orbitron', sans-serif;
    font-size: clamp(11px, 1.2vw, 14px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: {{ text_color }};
    opacity: 0.5;
  }

  /* ── Stack Wrapper / Pin Container ── */
  .ww-stack-wrapper {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 clamp(20px, 4vw, 60px);
  }

  .ww-cards-pin {
    position: relative;
    width: 100%;
    max-width: 480px;
    height: clamp(520px, 70vh, 680px);
    margin: 0 auto;
  }

  /* ── Individual Card ── */
  .ww-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22), 0 8px 20px rgba(0, 0, 0, 0.12);
    transform-origin: bottom center;
    cursor: pointer;
    transition: box-shadow 0.3s ease;
    will-change: transform;
  }

  .ww-card:hover {
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.32), 0 12px 28px rgba(0, 0, 0, 0.16);
  }

  /* Default stacking positions set by JS, but we pre-set CSS for no-JS fallback */
  .ww-card[data-index="0"] { z-index: 4; transform: rotate(-6deg) translateX(-20px); }
  .ww-card[data-index="1"] { z-index: 3; transform: rotate(-2deg) translateX(-8px); }
  .ww-card[data-index="2"] { z-index: 2; transform: rotate(2deg) translateX(8px); }
  .ww-card[data-index="3"] { z-index: 1; transform: rotate(6deg) translateX(20px); }
  .ww-card[data-index="4"] { z-index: 0; transform: rotate(9deg) translateX(32px); }

  .ww-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* ── Card Media ── */
  .ww-card-media {
    flex: 1;
    overflow: hidden;
    background: #1a1a1a;
  }

  .ww-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .ww-card:hover .ww-card-media img {
    transform: scale(1.04);
  }

  .ww-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
  }

  .ww-card-placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  /* ── Card Body (dark footer) ── */
  .ww-card-body {
    background: #111111;
    padding: 20px 22px 24px;
    flex-shrink: 0;
  }

  .ww-card-title {
    font-family: 'Orbitron', 'Rajdhani', sans-serif;
    font-size: clamp(14px, 2vw, 18px);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 8px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.2;
  }

  .ww-card-text {
    font-family: 'Rajdhani', sans-serif;
    font-size: clamp(12px, 1.4vw, 14px);
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
    line-height: 1.55;
  }

  /* ── Active Card (front) highlight ── */
  .ww-card.is-active {
    z-index: 10 !important;
    transform: rotate(0deg) translateX(0) translateY(-12px) !important;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.36);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .ww-label-row {
      flex-direction: column;
      gap: 6px;
      text-align: center;
    }

    .ww-cards-pin {
      max-width: 340px;
      height: clamp(420px, 80vw, 540px);
    }

    .ww-bg-text {
      font-size: clamp(48px, 14vw, 80px);
    }
  }

  @media (max-width: 480px) {
    .ww-cards-pin {
      max-width: 300px;
      height: clamp(380px, 90vw, 480px);
    }
  }
</style>

<script>
(function () {
  'use strict';

  function initWornWorldwide(sectionId) {
    const section   = document.getElementById('worn-worldwide-' + sectionId);
    if (!section) return;

    const cards = Array.from(section.querySelectorAll('.ww-card'));
    if (!cards.length) return;

    const total = cards.length;

    // ── Rotations & offsets for a natural spread ──
    const angles  = [-8, -3,  1,  5,  9, 13];
    const offsetsX = [-26, -10, 4, 18, 30, 42];
    const offsetsY = [  0,  -4, -6, -8, -8, -6];

    function applyStack() {
      cards.forEach(function (card, i) {
        const angle = angles[i] || (i * 4 - 4);
        const ox    = offsetsX[i] || (i * 14 - 14);
        const oy    = offsetsY[i] || 0;
        card.style.transform =
          'rotate(' + angle + 'deg) translate(' + ox + 'px, ' + oy + 'px)';
        card.style.zIndex = total - i;
        card.style.transition = 'transform 0.55s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s ease';
      });
    }

    function bringToFront(clickedIndex) {
      // Remove active from all
      cards.forEach(function (c) { c.classList.remove('is-active'); });

      // Re-stack from the clicked card forward
      const shifted = cards.slice(clickedIndex).concat(cards.slice(0, clickedIndex));
      shifted.forEach(function (card, i) {
        const angle = angles[i] || (i * 4 - 4);
        const ox    = offsetsX[i] || (i * 14 - 14);
        const oy    = offsetsY[i] || 0;
        card.style.transform =
          'rotate(' + angle + 'deg) translate(' + ox + 'px, ' + oy + 'px)';
        card.style.zIndex = total - i;
      });

      // Lift top card
      cards[clickedIndex].style.transform = 'rotate(0deg) translate(0px, -14px)';
      cards[clickedIndex].style.zIndex    = total + 1;
      cards[clickedIndex].classList.add('is-active');
    }

    // ── Apply initial stack ──
    applyStack();

    // ── Click to cycle ──
    cards.forEach(function (card, i) {
      card.addEventListener('click', function () {
        bringToFront(i);
      });
    });

    // ── GSAP ScrollTrigger entrance animation (if available) ──
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.fromTo(
        section.querySelector('.ww-cards-pin'),
        { opacity: 0, y: 60, scale: 0.93 },
        {
          scrollTrigger: {
            trigger: section,
            start: 'top 80%',
            toggleActions: 'play none none reverse'
          },
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 1,
          ease: 'power3.out'
        }
      );

      // Cards fan in sequentially on scroll
      gsap.fromTo(
        cards,
        { opacity: 0, y: 80 },
        {
          scrollTrigger: {
            trigger: section,
            start: 'top 75%',
            toggleActions: 'play none none reverse'
          },
          opacity: 1,
          y: 0,
          stagger: 0.1,
          duration: 0.9,
          ease: 'back.out(1.4)'
        }
      );
    } else {
      // Fallback: simple CSS fade-in
      section.style.opacity = '1';
    }
  }

  // ── Init ──
  function ready(fn) {
    if (document.readyState !== 'loading') { fn(); }
    else { document.addEventListener('DOMContentLoaded', fn); }
  }

  ready(function () {
    initWornWorldwide('{{ section.id }}');
  });

  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail.sectionId === '{{ section.id }}') {
      initWornWorldwide('{{ section.id }}');
    }
  });
})();
</script>

{% schema %}
{
  "name": "Worn Worldwide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WORN WORLDWIDE"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Eyebrow Label",
      "default": "COMMUNITY & CULTURE"
    },
    {
      "type": "text",
      "id": "bg_word",
      "label": "Giant Background Word",
      "default": "WORN WORLDWIDE",
      "info": "Large decorative text in the background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#e8e6e1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Community Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Community Drops"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "From Tokyo to Lagos — ONE9 is made for every timezone."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Worn Worldwide",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Awards & Glory",
            "text": "We've racked up so many awards, we're considering getting a second shelf — and maybe a third just in case."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Global Streets",
            "text": "Spotted in 80+ cities worldwide. ONE9 is streetwear without borders."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Creative Collabs",
            "text": "Art meets apparel. Our collaborations redefine the culture every season."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Community Drops",
            "text": "Limited drops made for and by the community. Tag us to be featured."
          }
        }
      ]
    }
  ]
}
{% endschema %}
