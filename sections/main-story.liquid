  .story-showcase-title {
    font-family: 'Orbitron', sans-serif;
    font-weight: 700;
    color: #ffffff;
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    letter-spacing: 0.1em;
    margin: 0;
    opacity: 0.8;
