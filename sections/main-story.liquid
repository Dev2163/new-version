    position: fixed;
    top: 0;
    right: 0;
    width: 2px;
    height: 100%;
    z-index: 99999;
    pointer-events: none;
    mix-blend-mode: difference;
  }
  .story-progress-bar {
    width: 100%;
    height: 100%;
    background-color: #f4c430;
    transform: scaleY(0);
    transform-origin: top;
    will-change: transform;
  }

  /* Particle Canvas */
  .story-particles-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    opacity: 0.75;
