</style>

<script>
  (function() {
    function initCinematicStory() {
      // 1. Lenis Smooth Scroll Initialisation
      let lenis;
      if (typeof Lenis !== 'undefined') {
        lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          gestureOrientation: 'vertical',
          smoothWheel: true
        });

        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
      }

      // 2. GSAP & ScrollTrigger Configuration
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        setTimeout(initCinematicStory, 100);
        return;
      }

      gsap.registerPlugin(ScrollTrigger);

      // Track Lenis Scroll in ScrollTrigger
      if (lenis) {
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);
      }

      // -- 1. HERO LOGO ANIMATIONS --
      const heroTimeline = gsap.timeline();
      heroTimeline.fromTo('.story-hero-logo',
        { opacity: 0, scale: 0.9, filter: 'blur(10px)' },
        { opacity: 1, scale: 1, filter: 'blur(0px)', duration: 2.2, ease: 'power3.out', delay: 0.4 }
      );
      heroTimeline.fromTo('.story-hero-logo-sweep',
        { x: '-100%', opacity: 0 },
        { x: '200%', opacity: 0.8, duration: 1.8, ease: 'power2.inOut' },
        '-=1.4'
      );

      gsap.to('.story-hero-logo', {
        scrollTrigger: {
          trigger: '.story-hero-section',
          start: 'top top',
          end: 'bottom top',
          scrub: 1.2
        },
        y: -120,
        scale: 0.82,
        opacity: 0,
        filter: 'blur(5px)',
        ease: 'power2.inOut'
      });

      // -- 2. CAROUSEL PARALLAX / PINNING --
      const carouselCards = gsap.utils.toArray('.story-carousel-card');
      if (carouselCards.length >= 3) {
        const [c1, c2, c3] = carouselCards;

        // Dynamic offset based on screen width for mobile responsiveness
        const isMobile = window.innerWidth < 768;
        const offsetVal = isMobile ? 85 : 120;
        const doubleOffsetVal = offsetVal * 2;

        // Set initial positions
        gsap.set(c1, { xPercent: 0, scale: 1, zIndex: 3, filter: 'brightness(1) blur(0px)', opacity: 1 });
        gsap.set(c2, { xPercent: offsetVal, scale: 0.8, zIndex: 2, filter: 'brightness(0.35) blur(4px)', opacity: 0.65 });
        gsap.set(c3, { xPercent: doubleOffsetVal, scale: 0.6, zIndex: 1, filter: 'brightness(0.15) blur(8px)', opacity: 0 });

        const carouselTimeline = gsap.timeline({
          scrollTrigger: {
            trigger: '#story-carousel-trigger',
            start: 'top top',
            end: '+=250%',
            pin: true,
            scrub: 1.2
          }
        });

        // Frame 1 -> Frame 2
        carouselTimeline.to(c1, { xPercent: -offsetVal, scale: 0.8, filter: 'brightness(0.35) blur(4px)', opacity: 0.65, ease: 'power2.inOut' }, 0)
          .to(c2, { xPercent: 0, scale: 1, filter: 'brightness(1) blur(0px)', opacity: 1, ease: 'power2.inOut' }, 0)
          .to(c3, { xPercent: offsetVal, scale: 0.8, filter: 'brightness(0.35) blur(4px)', opacity: 0.65, ease: 'power2.inOut' }, 0);

        // Frame 2 -> Frame 3
        carouselTimeline.to(c1, { xPercent: -doubleOffsetVal, scale: 0.6, filter: 'brightness(0.15) blur(8px)', opacity: 0, ease: 'power2.inOut' }, 1)
          .to(c2, { xPercent: -offsetVal, scale: 0.8, filter: 'brightness(0.35) blur(4px)', opacity: 0.65, ease: 'power2.inOut' }, 1)
          .to(c3, { xPercent: 0, scale: 1, filter: 'brightness(1) blur(0px)', opacity: 1, ease: 'power2.inOut' }, 1);

        carouselTimeline.to({}, { duration: 0.4 });
      }

      // -- 3. DETAIL IMAGES PIN & CROSSFADE --
      const detailTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: '#story-detail-trigger',
          start: 'top top',
          end: '+=200%',
          pin: true,
          scrub: 1.2
        }
      });

      const detailImages = gsap.utils.toArray('.story-detail-img');
      if (detailImages.length >= 3) {
        // Initial zoom / scale states
        gsap.set('#story-detail-wrapper', { scale: 0.8, clipPath: 'inset(20% 20% 20% 20%)' });
        gsap.set(detailImages[0], { opacity: 1, scale: 1 });
        gsap.set(detailImages[1], { opacity: 0, scale: 1.12 });
        gsap.set(detailImages[2], { opacity: 0, scale: 1.12 });

        // Phase 1: Expand Clip
        detailTimeline.to('#story-detail-wrapper', { scale: 1, clipPath: 'inset(0% 0% 0% 0%)', duration: 1, ease: 'power2.inOut' }, 0)
          .to(detailImages[0], { scale: 1.08, duration: 1, ease: 'none' }, 0)
          
          // Phase 2: Fade 1 -> 2
          .to(detailImages[0], { opacity: 0, duration: 0.5 }, 1)
          .to(detailImages[1], { opacity: 1, scale: 1, duration: 1, ease: 'power1.out' }, 1)

          // Phase 3: Fade 2 -> 3
          .to(detailImages[1], { opacity: 0, duration: 0.5 }, 2)
          .to(detailImages[2], { opacity: 1, scale: 1, duration: 1, ease: 'power1.out' }, 2)

          // Phase 4: Exit Blur
          .to('#story-detail-wrapper', { opacity: 0.25, filter: 'blur(8px)', duration: 0.5, ease: 'power2.inOut' }, 3);
      }

      // -- 4. STORY TEXT / BG IMAGE REVEAL --
      const revealTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: '#story-reveal-trigger',
          start: 'top center',
          end: 'bottom bottom',
          scrub: 1.2
        }
      });

      revealTimeline.fromTo('#story-reveal-bg-img',
        { y: 80, opacity: 0, filter: 'blur(8px)', scale: 1.1 },
        { y: 0, opacity: 0.35, filter: 'blur(0px)', scale: 1, duration: 1, ease: 'power2.out' }
      );

      const revealParagraphs = gsap.utils.toArray('.text-reveal');
      revealParagraphs.forEach((el, index) => {
        revealTimeline.fromTo(el,
          { y: 35, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.7, ease: 'power2.out' },
          `>-0.5`
        );
      });

      // -- 5. COLLECTION SHOWCASE ENTRY --
      const showcaseTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: '#story-showcase-trigger',
          start: 'top 60%',
          end: 'bottom 85%',
          scrub: 1.2
        }
      });

      const showcaseItems = gsap.utils.toArray('.story-showcase-item');
      showcaseItems.forEach((item, index) => {
        showcaseTimeline.fromTo(item,
          { y: 120, opacity: 0, scale: 0.92, filter: 'blur(8px)' },
          { y: 0, opacity: 1, scale: 1, filter: 'blur(0px)', duration: 1, ease: 'power2.out' },
          index * 0.25
        );
      });

      // -- 6. BRAND ENDING --
      const endingTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: '#story-ending-trigger',
          start: 'top 55%',
          end: 'bottom bottom',
          scrub: 1.2
        }
      });

      endingTimeline.fromTo('.story-ending-logo',
        { opacity: 0, scale: 0.9, filter: 'blur(6px)' },
        { opacity: 1, scale: 1, filter: 'blur(0px)', duration: 1, ease: 'power2.out' }
      );

      endingTimeline.fromTo('.story-ending-logo-sweep',
        { x: '-100%', opacity: 0 },
        { x: '200%', opacity: 0.8, duration: 1.4, ease: 'power2.inOut' },
        '<'
      );

      const taglineChars = gsap.utils.toArray('#story-ending-tagline span');
      endingTimeline.fromTo(taglineChars,
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.4, stagger: 0.08, ease: 'power2.out' },
        '>-0.4'
      );

      // -- 7. SCROLL PROGRESS TRACKING --
      gsap.to('#story-progress-bar', {
        scaleY: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: '#one9-story-container',
          start: 'top top',
          end: 'bottom bottom',
          scrub: true
        }
      });

      // -- 8. MANUAL HEADER SCROLL DIRECTION SYNC FOR LENIS --
      const headerComp = document.querySelector('header-component');
      if (headerComp) {
        let lastST = 0;
        window.addEventListener('scroll', () => {
          const st = window.pageYOffset || document.documentElement.scrollTop;
          if (st <= 15) {
            headerComp.dataset.scrollDirection = 'none';
            headerComp.dataset.stickyState = 'inactive';
          } else if (st < lastST) {
            // Scrolling up -> show header
            headerComp.dataset.scrollDirection = 'up';
            headerComp.dataset.stickyState = 'active';
            headerComp.classList.add('shopify-section-header-sticky');
            const parentSection = headerComp.closest('#shopify-section-header');
            if (parentSection) parentSection.classList.add('shopify-section-header-sticky');
          } else {
            // Scrolling down -> hide header
            headerComp.dataset.scrollDirection = 'down';
            headerComp.dataset.stickyState = 'idle';
          }
          lastST = st <= 0 ? 0 : st;
        }, { passive: true });
      }
    }

    // Canvas Particles Simulation
    function initParticles() {
      const canvas = document.getElementById('story-particles');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let width = window.innerWidth;
      let height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;

      const PARTICLE_COUNT = 140;
      const particles = [];

      const goldColors = ['rgba(244,196,48,', 'rgba(255,215,0,', 'rgba(212,160,23,'];
      const whiteColors = ['rgba(255,255,255,', 'rgba(240,240,240,', 'rgba(220,220,220,'];

      for (let i = 0; i < PARTICLE_COUNT; i++) {
        const isGold = Math.random() > 0.4;
        const colorBase = isGold
          ? goldColors[Math.floor(Math.random() * goldColors.length)]
          : whiteColors[Math.floor(Math.random() * whiteColors.length)];

        const x = Math.random() * width;
        const y = Math.random() * height;

        particles.push({
          x,
          y,
          z: Math.random(),
          vx: (Math.random() - 0.5) * 0.12,
          vy: (Math.random() - 0.5) * 0.1 - 0.04,
          size: Math.random() * 1.5 + 0.3,
          opacity: Math.random() * 0.4 + 0.1,
          color: colorBase,
          phase: Math.random() * Math.PI * 2,
          speed: Math.random() * 0.0025 + 0.001
        });
      }

      let mouseX = 0;
      let mouseY = 0;
      let scrollY = 0;
      let time = 0;

      window.addEventListener('mousemove', (e) => {
        mouseX = (e.clientX - width / 2) / width;
        mouseY = (e.clientY - height / 2) / height;
      });

      window.addEventListener('scroll', () => {
        scrollY = window.scrollY;
      }, { passive: true });

      window.addEventListener('resize', () => {
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = width;
        canvas.height = height;
      });

      function animate() {
        requestAnimationFrame(animate);
        time += 1;

        ctx.clearRect(0, 0, width, height);
        const parallaxOffsetY = -(scrollY * 0.2);

        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];

          // Sinusoidal drift movement
          p.x += p.vx + Math.sin(time * p.speed + p.phase) * 0.06;
          p.y += p.vy + Math.cos(time * p.speed * 0.65 + p.phase) * 0.05;

          // Parallax effect calculations
          const depthFactor = p.z * 6;
          const px = p.x + mouseX * depthFactor;
          const py = p.y + mouseY * depthFactor + parallaxOffsetY * p.z;

          // Wrapping bounds
          if (p.x < -20) p.x = width + 20;
          if (p.x > width + 20) p.x = -20;
          if (p.y < -height * 0.2) p.y = height + 20;
          if (p.y > height + 20) p.y = -height * 0.2;

          const pulse = Math.sin(time * p.speed * 1.8 + p.phase) * 0.12;
          const finalOpacity = Math.max(0, Math.min(1, p.opacity + pulse));
          const size = p.size * (0.5 + p.z * 0.8);

          // Outer Glow Gradient
          const grad = ctx.createRadialGradient(px, py, 0, px, py, size * 2.5);
          grad.addColorStop(0, p.color + finalOpacity + ')');
          grad.addColorStop(0.5, p.color + finalOpacity * 0.35 + ')');
          grad.addColorStop(1, p.color + '0)');

          ctx.beginPath();
          ctx.arc(px, py, size * 2.5, 0, Math.PI * 2);
          ctx.fillStyle = grad;
          ctx.fill();

          // Core dot
          ctx.beginPath();
          ctx.arc(px, py, size * 0.5, 0, Math.PI * 2);
          ctx.fillStyle = p.color + Math.min(1, finalOpacity * 1.6) + ')';
          ctx.fill();
        }
      }

      animate();
    }

    // Initialize all components after document loads
    window.addEventListener('DOMContentLoaded', () => {
      initCinematicStory();
      initParticles();
    });

    window.addEventListener('load', () => {
      initCinematicStory();
    });
  })();
</script>

