  }

  /* 6. Brand Ending Styles */
  .story-ending-section {
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .story-ending-logo-wrap {
    position: relative;
    overflow: hidden;
    display: inline-block;
    margin-bottom: 24px;
    will-change: transform;
  }
  .story-ending-logo {
    font-family: 'Orbitron', sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 10vw, 6.5rem);
    letter-spacing: 0.25em;
    color: #ffffff;
    margin: 0;
    text-shadow: 0 0 25px rgba(244, 196, 48, 0.2);
  }
  .story-ending-logo-sweep {
    position: absolute;
    inset: 0;
    width: 50%;
    height: 100%;
    background: linear-gradient(90deg, transparent, #f4c430, transparent);
    opacity: 0.8;
    mix-blend-mode: overlay;
