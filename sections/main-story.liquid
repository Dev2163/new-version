{% comment %}
  ONE9 Luxury Streetwear - Cinematic Scroll Story Section (GSAP & Lenis) - Luxury Gold Edition
{% endcomment %}

<!-- External Libraries (GSAP, ScrollTrigger, Lenis) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js" defer></script>

<div id="one9-story-container" class="one9-story-wrap">
  <!-- Scroll Progress Indicator -->
  <div class="story-scroll-progress">
    <div id="story-progress-bar" class="story-progress-bar"></div>
  </div>

  <!-- Interactive Canvas Particle Field -->
  <canvas id="story-particles" class="story-particles-canvas"></canvas>

  <!-- 1. Hero Section -->
  <section class="story-hero-section story-panel">
    <div class="story-hero-logo-wrap">
      <h1 class="story-hero-logo">ONE9</h1>
      <div class="story-hero-logo-sweep"></div>
    </div>
  </section>

  <!-- 2. Product Carousel Section (Pinned) -->
  <section id="story-carousel-trigger" class="story-carousel-section">
    <div class="story-carousel-container">
      <!-- Ambient Spotlight -->
      <div class="story-carousel-spotlight"></div>
      
      <!-- Carousel Cards -->
      <div class="story-carousel-cards-wrap">
        <div class="story-carousel-card" data-idx="0">
          <img src="{{ 'product-hoodie.jpg' | asset_url }}" alt="ONE9 Hoodie" loading="eager" width="500" height="667">
          <div class="story-card-vignette"></div>
        </div>
        <div class="story-carousel-card" data-idx="1">
          <img src="{{ 'product-tee.jpg' | asset_url }}" alt="ONE9 Graphic Tee" loading="eager" width="500" height="667">
          <div class="story-card-vignette"></div>
        </div>
        <div class="story-carousel-card" data-idx="2">
          <img src="{{ 'product-joggers.jpg' | asset_url }}" alt="ONE9 Joggers" loading="eager" width="500" height="667">
          <div class="story-card-vignette"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Detail Crossfade Section (Pinned) -->
  <section id="story-detail-trigger" class="story-detail-section">
    <div class="story-detail-container">
      <div id="story-detail-wrapper" class="story-detail-image-wrapper">
        <img class="story-detail-img active" src="{{ 'detail-1.jpg' | asset_url }}" alt="Detail 1" loading="lazy" width="800" height="800">
        <img class="story-detail-img" src="{{ 'detail-2.jpg' | asset_url }}" alt="Detail 2" loading="lazy" width="800" height="800">
        <img class="story-detail-img" src="{{ 'detail-3.jpg' | asset_url }}" alt="Detail 3" loading="lazy" width="800" height="800">
        <div class="story-detail-vignette"></div>
      </div>
      <!-- Ambient Text -->
      <div class="story-detail-text">
        <p class="story-detail-italic">Woven Intention</p>
      </div>
    </div>
  </section>

  <!-- 4. Story Reveal Section -->
  <section id="story-reveal-trigger" class="story-reveal-section story-panel">
    <!-- Emerging Background Image -->
    <div class="story-reveal-bg">
      <img id="story-reveal-bg-img" src="{{ 'product-hoodie.jpg' | asset_url }}" alt="Aquarius Hoodie" loading="lazy" width="800" height="800">
      <div class="story-reveal-overlay"></div>
    </div>
    <!-- Story Text Content -->
    <div class="story-reveal-content">
      <h2 class="story-reveal-title text-reveal">Aquarius</h2>
      <p class="story-reveal-subtitle text-reveal">"Inspired by the timeless flow of knowledge and creativity."</p>
      <div class="story-reveal-meta text-reveal">
        <span>Premium heavyweight cotton</span>
        <span>Designed for everyday luxury</span>
        <span class="story-reveal-limited">Limited Edition</span>
      </div>
    </div>
  </section>

  <!-- 5. Collection Showcase -->
  <section id="story-showcase-trigger" class="story-showcase-section">
    <div class="story-showcase-container">
      <div class="story-showcase-grid">
        <!-- Item 1 -->
        <div class="story-showcase-item">
          <div class="story-showcase-img-wrap">
            <img src="{{ 'product-hoodie.jpg' | asset_url }}" alt="Aquarius Hoodie" loading="lazy" width="400" height="533">
            <div class="story-showcase-glow"></div>
          </div>
          <h3 class="story-showcase-title">Aquarius Hoodie</h3>
        </div>
        <!-- Item 2 -->
        <div class="story-showcase-item">
          <div class="story-showcase-img-wrap">
            <img src="{{ 'product-tee.jpg' | asset_url }}" alt="Aquarius Tee" loading="lazy" width="400" height="533">
            <div class="story-showcase-glow"></div>
          </div>
          <h3 class="story-showcase-title">Aquarius Tee</h3>
        </div>
        <!-- Item 3 -->
        <div class="story-showcase-item">
          <div class="story-showcase-img-wrap">
            <img src="{{ 'product-joggers.jpg' | asset_url }}" alt="Aquarius Joggers" loading="lazy" width="400" height="533">
            <div class="story-showcase-glow"></div>
          </div>
          <h3 class="story-showcase-title">Aquarius Joggers</h3>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Brand Ending Section -->
  <section id="story-ending-trigger" class="story-ending-section story-panel">
    <div class="story-ending-logo-wrap">
      <h2 class="story-ending-logo">ONE9</h2>
      <div class="story-ending-logo-sweep"></div>
    </div>
    <p id="story-ending-tagline" class="story-ending-tagline">
      <span>W</span><span>e</span><span>a</span><span>r</span><span>&nbsp;</span><span>Y</span><span>o</span><span>u</span><span>r</span><span>&nbsp;</span><span>S</span><span>t</span><span>o</span><span>r</span><span>y</span>
    </p>
  </section>
</div>

<style>
